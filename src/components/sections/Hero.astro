---
import Placeholder from "../Placeholder.astro";
---

<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <Placeholder label="Hero aerial" ratio="auto" class="hero__ph" />
  </div>

  <div class="hero__content container">
    <p class="eyebrow reveal">A City of Purpose</p>
    <p class="hero__brand reveal">Miracle Dome City</p>
    <h1 class="hero__tagline reveal">Where Heaven Meets Earth</h1>
    <p class="lede reveal">
      A landmark vision taking shape in Sri Lanka — a place for the multitudes,
      a home for the weary, a mountain for prayer, and a city of purpose.
    </p>
    <div class="hero__actions reveal">
      <a class="btn" href="#explore">Explore the City <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    padding: calc(var(--header-h) + 4rem) 0 5.5rem;
  }

  .hero__media { position: absolute; inset: 0; }

  .hero__media :global(.hero__ph) {
    min-height: 100%;
    height: 100%;
    aspect-ratio: auto;
    animation: drift 22s ease-in-out infinite alternate;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 14, 18, 0.88) 0%, rgba(12, 14, 18, 0.45) 48%, rgba(12, 14, 18, 0.25) 100%),
      linear-gradient(180deg, rgba(12, 14, 18, 0.35) 0%, rgba(12, 14, 18, 0.12) 40%, rgba(12, 14, 18, 0.9) 100%);
  }

  .hero__content { position: relative; z-index: 1; max-width: 40rem; }

  .hero__brand {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8vw, 6.2rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .hero__tagline {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    font-weight: 500;
    font-style: italic;
    color: var(--color-gold-bright);
    letter-spacing: 0.04em;
  }

  .hero__actions { margin-top: 2rem; }
  .hero__tagline.reveal { transition-delay: 0.12s; }
  .lede.reveal { transition-delay: 0.22s; }
  .hero__actions.reveal { transition-delay: 0.34s; }

  @keyframes drift {
    from { transform: scale(1.02); }
    to { transform: scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(.hero__ph) { animation: none; }
  }
</style>

<script>
  requestAnimationFrame(() => {
    document.querySelectorAll(".hero .reveal").forEach((el) => el.classList.add("is-visible"));
  });
</script>
