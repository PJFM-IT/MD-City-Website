---
import Placeholder from "../Placeholder.astro";
import { media } from "../../data/site";
---

<section class="final-hero band" id="final-hero">
  <div class="band__media" aria-hidden="true">
    <div data-parallax="0.12">
      <Placeholder label="Miracle Dome City aerial at night" ratio="auto" src={media.finalHero || undefined} scene="aerial-night" seed={33} />
    </div>
  </div>
  <div class="final-hero__content container-wide reveal">
    <p class="eyebrow final-hero__eyebrow">This is more than a vision.</p>
    <h2 class="final-hero__title">It is a legacy.</h2>
    <p class="final-hero__brand">Miracle Dome City</p>
    <p class="tagline">Where Heaven Meets Earth</p>
    <a class="btn" href="#contact">Be part of the vision <span aria-hidden="true">→</span></a>
    <p class="final-hero__possible">The Vision Is Possible.</p>
  </div>
</section>

<style>
  .final-hero {
    min-height: 82svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-2xl);
  }

  .final-hero .band__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 14, 18, 0.85) 0%, rgba(12, 14, 18, 0.45) 45%, rgba(12, 14, 18, 0.1) 100%),
      linear-gradient(180deg, rgba(12, 14, 18, 0.2), rgba(12, 14, 18, 0.6));
  }

  .final-hero__content {
    position: relative;
    z-index: 1;
  }

  .final-hero__eyebrow {
    letter-spacing: 0.32em;
  }

  .final-hero__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
  }

  .final-hero__brand {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .final-hero__content .tagline {
    margin-top: 0.6rem;
  }

  .final-hero__content .btn {
    margin-top: 2rem;
  }

  .final-hero__possible {
    margin-top: 1.6rem;
    color: var(--color-stone-soft);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-style: italic;
  }
</style>
