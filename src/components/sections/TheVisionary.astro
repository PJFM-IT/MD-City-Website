---
import Placeholder from "../Placeholder.astro";
import { media } from "../../data/site";
---

<section class="visionary band" id="visionary">
  <div class="visionary__portrait reveal">
    <Placeholder label="Prophet Jerome Fernando" ratio="auto" class="visionary__ph" src={media.visionary || undefined} scene="portrait" />
  </div>
  <div class="visionary__copy reveal">
    <p class="eyebrow">The Visionary</p>
    <h2 class="display">Prophet Jerome Fernando</h2>
    <p class="visionary__text">
      A man with a God-given vision to see lives transformed, nations impacted
      and a generation encounter the power of God. Miracle Dome City is part of
      a greater mandate to bring hope, healing and the Gospel to the nations.
    </p>
    <a class="text-link" href="https://prophetjerome.com/about/" target="_blank" rel="noreferrer">
      Read more <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .visionary {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    min-height: min(56vh, 480px);
    overflow: hidden;
    background:
      linear-gradient(90deg, #111 0%, #2c2b29 45%, #8a8680 100%);
  }

  .visionary__portrait {
    position: relative;
    align-self: stretch;
    min-height: 360px;
  }

  .visionary__portrait :global(.visionary__ph) {
    position: absolute;
    inset: 0;
    min-height: 100%;
    aspect-ratio: auto;
    filter: grayscale(1);
  }

  .visionary__portrait::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 55%, #2c2b29 100%);
  }

  .visionary__copy {
    padding: var(--band-pad) clamp(1.25rem, 5vw, 4.5rem);
    max-width: 38rem;
  }

  .visionary__copy .display {
    max-width: none;
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
  }

  .visionary__text {
    margin-top: 1rem;
    color: rgba(244, 241, 236, 0.85);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .visionary {
      grid-template-columns: 1fr;
      background: linear-gradient(180deg, #111 0%, #2c2b29 100%);
    }

    .visionary__portrait { min-height: 380px; }

    .visionary__portrait::after {
      background: linear-gradient(180deg, transparent 60%, #2c2b29 100%);
    }
  }
</style>
