---
const stats = [
  { value: 24000, label: "Capacity", sub: "Zion Grounds", icon: null },
  { value: 1500, label: "Beds", sub: "Accommodation", icon: null },
  { value: null, label: "Large", sub: "Car Park", icon: "car" },
  { value: null, label: "One Vision", sub: "Miracle Dome City", icon: "globe" },
];
const format = new Intl.NumberFormat("en-US");
---

<section class="numbers band" id="city-numbers">
  <div class="numbers__inner container-wide reveal">
    <h2 class="numbers__heading">The City<br />in Numbers</h2>
    <div class="numbers__grid">
      {
        stats.map((stat) => (
          <article class="numbers__item">
            {stat.icon === "car" && (
              <span class="numbers__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M3 13.5h18l-1.5-5.2A2 2 0 0 0 17.6 7H6.4a2 2 0 0 0-1.9 1.3L3 13.5Z" />
                  <path d="M3 13.5h18v2.2a1.3 1.3 0 0 1-1.3 1.3H4.3A1.3 1.3 0 0 1 3 15.7v-2.2Z" />
                  <path d="M6.5 17v1.5M17.5 17v1.5" />
                </svg>
              </span>
            )}
            {stat.icon === "globe" && (
              <span class="numbers__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.3">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" />
                </svg>
              </span>
            )}
            {stat.value !== null && (
              <p class="numbers__value" data-count={stat.value}>{format.format(stat.value)}</p>
            )}
            <p class="numbers__label">{stat.label}</p>
            <p class="numbers__sub">{stat.sub}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .numbers {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    background:
      radial-gradient(ellipse at 15% 50%, rgba(201, 164, 92, 0.08), transparent 55%),
      #0a0c10;
  }

  .numbers__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .numbers__heading {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.15;
  }

  .numbers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .numbers__item {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.5rem 1rem;
    text-align: center;
    border-left: 1px solid var(--color-line);
  }

  .numbers__item:first-child { border-left: 0; }

  .numbers__icon {
    display: grid;
    place-items: center;
    min-height: 2.6rem;
    color: var(--color-white);
  }

  .numbers__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    color: var(--color-white);
  }

  .numbers__label {
    color: var(--color-stone);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .numbers__sub {
    color: var(--color-white);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .numbers__inner { grid-template-columns: 1fr; text-align: center; }
    .numbers__heading br { display: none; }
  }

  @media (max-width: 640px) {
    .numbers__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 1.5rem;
    }

    .numbers__item:nth-child(odd) { border-left: 0; }
  }
</style>

<script>
  import { countUpOnView } from "../../scripts/motion";

  countUpOnView();
</script>
