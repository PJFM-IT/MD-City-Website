---
import Placeholder from "../Placeholder.astro";
import { VISION_FILM_URL, media } from "../../data/site";
---

<section class="vision band" id="vision">
  <article class="vision__copy">
    <div class="band__media" aria-hidden="true">
      <div data-parallax="0.06">
        <Placeholder label="Miracle Dome City render" ratio="auto" src={media.vision || undefined} scene="vision" />
      </div>
    </div>
    <div class="vision__copy-body reveal">
      <p class="eyebrow">The Vision</p>
      <h2 class="display">More than<br />a destination.</h2>
      <p class="vision__sub">A city of purpose.</p>
      <p class="vision__text">
        Miracle Dome City is a visionary development envisioned to impact
        nations — a place for worship, healing, prayer, transformation and the
        ministry to the multitudes.
      </p>
      <p class="vision__credit">
        A vision of<br /><strong>Prophet Jerome Fernando</strong>
      </p>
    </div>
  </article>

  <article class="vision__film reveal" id="vision-film">
    <p class="eyebrow vision__film-eyebrow">Experience the Vision</p>
    <button class="vision__panel" type="button" data-film-open aria-haspopup="dialog">
      <Placeholder label="Vision film still" ratio="16 / 10" class="vision__film-ph" src={media.filmPoster || undefined} scene="film" />
      <span class="vision__panel-inner">
        <span class="play-icon vision__play" aria-hidden="true"></span>
        <span class="vision__panel-label">Watch the Vision</span>
      </span>
    </button>
    <p class="vision__meta-text">Discover the story and future of Miracle Dome City.</p>
  </article>

  <dialog class="modal film-modal" data-film-modal aria-label="Vision film">
    <button class="modal__close" type="button" data-film-close aria-label="Close video">×</button>
    <div class="film-modal__frame" data-film-frame data-src={VISION_FILM_URL}>
      <div class="film-modal__soon">
        <span class="play-icon" aria-hidden="true"></span>
        <p class="eyebrow">The Vision Film</p>
        <p class="film-modal__soon-title">Coming soon</p>
        <p class="film-modal__soon-text">The story and future of Miracle Dome City.</p>
      </div>
    </div>
  </dialog>
</section>

<style>
  .vision {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    min-height: min(80vh, 640px);
    background: var(--color-charcoal);
  }

  .vision__copy {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .vision__copy .band__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 14, 18, 0.9) 0%, rgba(12, 14, 18, 0.55) 38%, transparent 70%);
    pointer-events: none;
  }

  .vision__copy-body {
    position: relative;
    z-index: 1;
    max-width: 38rem;
    padding: var(--band-pad) clamp(1.25rem, 4vw, 4rem);
  }

  .vision__copy-body .display {
    max-width: none;
    font-size: clamp(1.8rem, 3.3vw, 2.7rem);
  }

  .vision__text {
    max-width: 24rem;
  }

  .vision__sub {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vision__text {
    margin-top: 1.1rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .vision__credit {
    margin-top: 1.75rem;
    color: var(--color-gold);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .vision__credit strong {
    color: var(--color-white);
    font-weight: 400;
  }

  .vision__credit::after {
    content: "";
    display: block;
    width: 1.6rem;
    height: 1px;
    margin-top: 0.8rem;
    background: var(--color-gold);
  }

  .vision__film {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.1rem;
    padding: var(--band-pad) clamp(1.25rem, 3vw, 2.5rem);
    background: linear-gradient(180deg, #101318, #0a0c10);
    border-left: 1px solid var(--color-line);
    text-align: center;
  }

  .vision__film-eyebrow {
    margin: 0;
    color: var(--color-white);
    letter-spacing: 0.3em;
  }

  .vision__panel {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: none;
    color: var(--color-white);
    cursor: pointer;
    transition: border-color 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .vision__panel :global(.vision__film-ph) {
    position: absolute;
    inset: 0;
    min-height: 100%;
    aspect-ratio: auto;
    transition: transform 1.2s var(--ease-out);
  }

  .vision__panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(12, 14, 18, 0.3);
  }

  .vision__panel-inner {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .vision__play {
    width: 3.6rem;
    height: 3.6rem;
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .vision__panel-label {
    font-size: 0.66rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .vision__panel:hover,
  .vision__panel:focus-visible {
    border-color: var(--color-gold);
    box-shadow: 0 0 40px rgba(201, 164, 92, 0.18);
    outline: none;
  }

  .vision__panel:hover :global(.vision__film-ph),
  .vision__panel:focus-visible :global(.vision__film-ph) {
    transform: scale(1.05);
  }

  .vision__panel:hover .vision__play,
  .vision__panel:focus-visible .vision__play {
    transform: scale(1.1);
    border-color: var(--color-gold-bright);
    color: var(--color-gold-bright);
  }

  .vision__meta-text {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .film-modal__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 88svh;
    background: #000;
  }

  .film-modal__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .film-modal__soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: 1.5rem;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(201, 164, 92, 0.18), transparent 60%),
      #0a0c10;
  }

  .film-modal__soon .eyebrow { margin: 0.6rem 0 0; }

  .film-modal__soon-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .film-modal__soon-text {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .vision { grid-template-columns: 1fr; }
    .vision__copy { min-height: 460px; }
    .vision__film { border-left: 0; border-top: 1px solid var(--color-line); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vision__panel :global(.vision__film-ph) { transition: none; }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>("[data-film-modal]");
  const frame = modal?.querySelector<HTMLElement>("[data-film-frame]");
  const src = frame?.dataset.src?.trim();

  const open = () => {
    if (!modal || !frame) return;
    if (src) {
      const iframe = document.createElement("iframe");
      const url = new URL(src);
      url.searchParams.set("autoplay", "1");
      url.searchParams.set("rel", "0");
      iframe.src = url.href;
      iframe.title = "Miracle Dome City — The Vision";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    }
    modal.showModal();
  };

  // Removing the iframe on close stops playback.
  modal?.addEventListener("close", () => {
    if (src) frame?.replaceChildren();
  });

  document.querySelector("[data-film-open]")?.addEventListener("click", open);
  modal?.querySelector("[data-film-close]")?.addEventListener("click", () => modal.close());
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) modal.close();
  });
</script>
