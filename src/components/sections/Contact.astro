---
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const inquiryEmail =
  import.meta.env.PUBLIC_INQUIRY_EMAIL?.trim() || "info@prophetjerome.com";
const formAction = formspreeId
  ? `https://formspree.io/f/${formspreeId}`
  : `mailto:${inquiryEmail}`;
const usesMailto = !formspreeId;
---

<section class="contact section" id="contact">
  <div class="contact__grid container-wide">
    <div class="contact__copy reveal">
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Be part of the vision</h2>
      <p class="section-lede">
        Share your inquiry and our team will respond by email. Visit the Miracle
        Dome on Katunayake–Veyangoda Road, Katunayake, Sri Lanka — or reach
        Prophet Jerome Fernando Ministries directly.
      </p>
      <ul class="contact__details">
        <li>
          <span>Email</span>
          <a href={`mailto:${inquiryEmail}`}>{inquiryEmail}</a>
        </li>
        <li>
          <span>Phone</span>
          <a href="tel:+94117774877">+94 11 777 4877</a>
        </li>
        <li>
          <span>Location</span>
          <p>Miracle Dome, Katunayake–Veyangoda Road, Katunayake, Sri Lanka</p>
        </li>
      </ul>
    </div>

    <form
      class="contact__form reveal"
      action={formAction}
      method={usesMailto ? "GET" : "POST"}
      enctype={usesMailto ? "text/plain" : undefined}
      data-contact-form
      data-mailto={usesMailto ? "true" : undefined}
    >
      {
        !usesMailto && (
          <>
            <input type="hidden" name="_subject" value="Miracle Dome City Inquiry" />
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="contact__honeypot" aria-hidden="true" />
          </>
        )
      }
      <label>
        <span>Name</span>
        <input type="text" name="name" required autocomplete="name" data-field="name" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" data-field="email" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="5" required data-field="message"></textarea>
      </label>
      <button class="btn btn--solid" type="submit" data-submit>
        Send inquiry
      </button>
      <p class="contact__status" data-status hidden></p>
    </form>
  </div>
</section>

<style>
  .contact {
    background: #0d1014;
    border-top: 1px solid var(--color-line);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__details {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .contact__details span {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-gold);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact__details a,
  .contact__details p {
    color: var(--color-muted);
  }

  .contact__details a:hover {
    color: var(--color-gold-bright);
  }

  .contact__form {
    display: grid;
    gap: 1rem;
  }

  .contact__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  label {
    display: grid;
    gap: 0.45rem;
  }

  label span {
    color: var(--color-stone);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-white);
    outline: none;
    transition: border-color 0.25s var(--ease-out);
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-gold);
  }

  .contact__status {
    margin: 0;
    font-size: 0.9rem;
  }

  .contact__status.is-success {
    color: var(--color-gold-bright);
  }

  .contact__status.is-error {
    color: #e8a0a0;
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ inquiryEmail, usesMailto, formAction }}>
  const form = document.querySelector("[data-contact-form]");
  const status = form?.querySelector("[data-status]");
  const submitBtn = form?.querySelector("[data-submit]");

  const setStatus = (message, type) => {
    if (!status) return;
    status.hidden = !message;
    status.textContent = message;
    status.classList.toggle("is-success", type === "success");
    status.classList.toggle("is-error", type === "error");
  };

  form?.addEventListener("submit", async (event) => {
    if (usesMailto) {
      event.preventDefault();
      const name = form.querySelector("[data-field='name']")?.value.trim() ?? "";
      const email = form.querySelector("[data-field='email']")?.value.trim() ?? "";
      const message = form.querySelector("[data-field='message']")?.value.trim() ?? "";
      const subject = encodeURIComponent(`Miracle Dome City Inquiry — ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
      window.location.href = `mailto:${inquiryEmail}?subject=${subject}&body=${body}`;
      return;
    }

    event.preventDefault();
    setStatus("", "");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending…";
    }

    try {
      const response = await fetch(formAction, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        form.reset();
        setStatus("Thank you. Your inquiry was sent successfully.", "success");
      } else {
        const data = await response.json().catch(() => null);
        const errorMessage =
          data?.errors?.map((e) => e.message).join(", ") ||
          "Something went wrong. Please try again.";
        setStatus(errorMessage, "error");
      }
    } catch {
      setStatus("Network error. Please check your connection and try again.", "error");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send inquiry";
      }
    }
  });
</script>
