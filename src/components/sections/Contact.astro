---
const inquiryEmail =
  import.meta.env.PUBLIC_INQUIRY_EMAIL?.trim() || "info@prophetjerome.com";
const phoneDisplay = "+94 11 777 4877";
const phoneLink = "tel:+94117774877";
---

<section class="contact section" id="contact">
  <div class="contact__grid container-wide">
    <div class="contact__copy reveal">
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Be part of the vision</h2>
      <p class="section-lede">
        Write to us or give us a call and our team will be glad to help. Visit the
        Miracle Dome on Katunayake–Veyangoda Road, Katunayake, Sri Lanka — or reach
        Prophet Jerome Fernando Ministries directly.
      </p>
      <div class="contact__location">
        <span>Location</span>
        <p>Miracle Dome, Katunayake–Veyangoda Road, Katunayake, Sri Lanka</p>
      </div>
    </div>

    <div class="contact__cards reveal">
      <a class="contact__card" href={`mailto:${inquiryEmail}`}>
        <span class="contact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m3.5 6 8.5 7 8.5-7"></path></svg>
        </span>
        <span class="contact__text">
          <span class="contact__label">Email</span>
          <span class="contact__value">{inquiryEmail}</span>
          <span class="contact__hint">Write to us <span aria-hidden="true">→</span></span>
        </span>
      </a>

      <a class="contact__card" href={phoneLink} data-contact-phone>
        <span class="contact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"></path></svg>
        </span>
        <span class="contact__text">
          <span class="contact__label">Phone</span>
          <span class="contact__value">{phoneDisplay}</span>
          <span class="contact__hint contact__hint--call">Tap to call <span aria-hidden="true">→</span></span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-charcoal);
    border-top: 1px solid var(--color-line);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .contact__location {
    margin-top: 1.75rem;
  }

  .contact__location span,
  .contact__label {
    display: block;
    color: var(--color-gold);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact__location p {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
  }

  .contact__cards {
    display: grid;
    gap: 1rem;
  }

  .contact__card {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.6rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-white);
    transition:
      border-color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  a.contact__card:hover,
  a.contact__card:focus-visible {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    outline: none;
  }

  .contact__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-gold);
  }

  .contact__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .contact__text {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .contact__value {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    overflow-wrap: anywhere;
  }

  .contact__hint {
    color: var(--color-stone);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.3s var(--ease-out);
  }

  a.contact__card:hover .contact__hint,
  a.contact__card:focus-visible .contact__hint {
    color: var(--color-gold);
  }

  /* Computers (mouse pointer): the phone number is shown, not dialled. */
  .contact__card.is-static .contact__hint--call {
    display: none;
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // On computers a "tel:" link has nothing to dial with, so the number is just shown there.
  // Phones and tablets keep it as a tap-to-call link.
  const phone = document.querySelector<HTMLAnchorElement>("[data-contact-phone]");
  const desktop = window.matchMedia("(hover: hover) and (pointer: fine)");
  const tel = phone?.getAttribute("href") ?? "";

  const sync = () => {
    if (!phone) return;
    phone.classList.toggle("is-static", desktop.matches);
    if (desktop.matches) phone.removeAttribute("href");
    else phone.setAttribute("href", tel);
  };

  sync();
  desktop.addEventListener("change", sync);
</script>
