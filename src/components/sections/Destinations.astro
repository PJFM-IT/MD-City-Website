---
import Placeholder from "../Placeholder.astro";
import { media } from "../../data/site";

const destinations = [
  {
    id: "zion-grounds",
    scene: "zion",
    image: media.zion,
    number: "01",
    title: "Zion Grounds",
    headline: "A ground for the multitudes.",
    stat: "24,000 Capacity",
    detail: "A monumental gathering ground envisioned for crusades, worship, ministry and gatherings of multitudes.",
  },
  {
    id: "carmel-hill",
    scene: "carmel",
    image: media.carmel,
    number: "02",
    title: "Carmel Hill",
    headline: "A place set apart. For prayer. For encounter.",
    stat: null,
    detail: "A dedicated place of prayer and encounter within Miracle Dome City.",
  },
  {
    id: "facility",
    scene: "facility",
    image: media.facility,
    number: "03",
    title: "1,500-Bed Facility",
    headline: "Built to serve.",
    stat: null,
    detail: "Accommodation and food facilities for those travelling long distances and those coming seeking ministry and healing.",
  },
] as const;
---

<section class="destinations band" id="destinations" aria-label="Destinations">
  {
    destinations.map((item, index) => (
      <article class="destination reveal" id={item.id} style={`transition-delay:${index * 0.12}s`}>
        <div class="destination__media">
          <Placeholder label={`${item.title} render`} ratio="auto" class="destination__ph" src={item.image || undefined} scene={item.scene} />
        </div>
        <div class="destination__body">
          <p class="destination__num">{item.number}</p>
          <h3 class="destination__title">{item.title}</h3>
          <p class="destination__headline">{item.headline}</p>
          {item.stat && <p class="destination__stat">{item.stat}</p>}
          <p class="destination__text">{item.detail}</p>
          <a class="text-link" href="#contact">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))
  }
</section>

<style>
  .destinations {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--color-charcoal);
  }

  .destination {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(460px, 42vw, 600px);
    overflow: hidden;
    border-right: 1px solid var(--color-line);
  }

  .destination:last-child {
    border-right: 0;
  }

  .destination__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .destination__media :global(.destination__ph) {
    height: 100%;
    min-height: 100%;
    aspect-ratio: auto;
    transition: transform 1.4s var(--ease-out);
  }

  .destination__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(12, 14, 18, 0) 25%, rgba(12, 14, 18, 0.75) 55%, rgba(12, 14, 18, 0.97) 80%);
  }

  .destination:hover .destination__media :global(.destination__ph),
  .destination:focus-within .destination__media :global(.destination__ph) {
    transform: scale(1.06);
  }

  .destination__body {
    position: relative;
    z-index: 1;
    padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem) 2rem;
  }

  .destination__num {
    color: var(--color-gold);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
  }

  .destination__title {
    margin-top: 0.3rem;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
  }

  .destination__headline {
    margin-top: 0.5rem;
    max-width: 22rem;
    color: var(--color-gold-bright);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .destination__stat {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .destination__text {
    margin-top: 0.8rem;
    max-width: 22rem;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .destination .text-link {
    position: relative;
  }

  .destination .text-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2rem;
    height: 1px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .destination:hover .text-link::after,
  .destination .text-link:focus-visible::after {
    transform: scaleX(1);
  }

  @media (max-width: 900px) {
    .destinations { grid-template-columns: 1fr; }

    .destination {
      min-height: 420px;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .destination:last-child { border-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .destination__media :global(.destination__ph) { transition: none; }
  }
</style>
