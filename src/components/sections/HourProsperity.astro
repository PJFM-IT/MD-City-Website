---
import Placeholder from "../Placeholder.astro";
import { media, prosperityGallery } from "../../data/site";

const lead = { ...prosperityGallery[0], src: media.prosperity || prosperityGallery[0].src };
---

<section class="prosperity band" id="hour-of-prosperity">
  <div class="band__media" aria-hidden="true" data-gallery-item="prosperity-0">
    <div data-parallax="0.08">
      <Placeholder label={lead.alt} src={lead.src || undefined} scene={lead.scene} ratio="auto" />
    </div>
  </div>
  <div class="prosperity__copy container-wide reveal">
    <p class="eyebrow">The Hour of Prosperity</p>
    <h2 class="display">Faith on the land.</h2>
    <p class="prosperity__text">
      On the very land of Miracle Dome City, partners gathered together in
      prayer. A moment of faith, declaration and prayer over the land and the
      vision that would rise upon it.
    </p>
    <button class="btn" type="button" data-lightbox="prosperity" data-index="0">
      View moments <span aria-hidden="true">→</span>
    </button>
  </div>
</section>

<style>
  .prosperity {
    min-height: min(62vh, 560px);
    display: grid;
    align-items: center;
    overflow: hidden;
    padding-block: var(--band-pad);
  }

  .prosperity .band__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 14, 18, 0.9) 0%, rgba(12, 14, 18, 0.55) 38%, rgba(12, 14, 18, 0.05) 75%),
      linear-gradient(180deg, transparent 60%, rgba(12, 14, 18, 0.5));
  }

  .prosperity__copy {
    position: relative;
    z-index: 1;
  }

  .prosperity__text {
    margin-top: 1rem;
    max-width: 25rem;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .prosperity__copy .btn { margin-top: 1.4rem; }
</style>
