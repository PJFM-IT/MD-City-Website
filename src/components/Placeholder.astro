---
interface Props {
  label?: string;
  ratio?: string;
  class?: string;
}

const { label = "Image", ratio = "16 / 9", class: className = "" } = Astro.props;
---

<div class:list={["ph", className]} style={`--ph-ratio: ${ratio}`} role="img" aria-label={label}>
  <span class="ph__grain" aria-hidden="true"></span>
</div>

<style>
  .ph {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 12rem;
    aspect-ratio: var(--ph-ratio);
    overflow: hidden;
    background:
      radial-gradient(ellipse at 28% 18%, rgba(201, 164, 92, 0.1), transparent 50%),
      radial-gradient(ellipse at 78% 70%, rgba(184, 167, 142, 0.06), transparent 45%),
      linear-gradient(155deg, #171b22 0%, #0c0e12 52%, #12100c 100%);
  }

  .ph__grain {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background: linear-gradient(115deg, transparent 40%, rgba(255, 255, 255, 0.03) 50%, transparent 60%);
  }
</style>
