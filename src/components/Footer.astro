---
import Brand from "./Brand.astro";
import { footerLinks as links } from "../data/site";

const social = [
  {
    label: "YouTube",
    href: "https://www.youtube.com/@ProphetJeromeFernando",
    path: "M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com",
    path: "M12 7.2a4.8 4.8 0 1 0 0 9.6 4.8 4.8 0 0 0 0-9.6Zm0 7.9a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2Zm6.1-8.1a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM16.5 2h-9A5.5 5.5 0 0 0 2 7.5v9A5.5 5.5 0 0 0 7.5 22h9a5.5 5.5 0 0 0 5.5-5.5v-9A5.5 5.5 0 0 0 16.5 2Zm3.8 14.5a3.8 3.8 0 0 1-3.8 3.8h-9a3.8 3.8 0 0 1-3.8-3.8v-9a3.8 3.8 0 0 1 3.8-3.8h9a3.8 3.8 0 0 1 3.8 3.8v9Z",
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com",
    path: "M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.2h2.8V22h3.4Z",
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner container-wide">
    <Brand variant="full" />

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__meta">
      <div class="site-footer__social">
        {
          social.map((s) => (
            <a href={s.href} target="_blank" rel="noreferrer" aria-label={s.label}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          ))
        }
      </div>
      <p class="site-footer__url">miracle-domecity.com</p>
    </div>
  </div>
  <div class="site-footer__legal container-wide">
    <p>© {new Date().getFullYear()} Miracle Dome City · Prophet Jerome Fernando Ministries</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #080a0d;
    padding-block: 2rem 1.25rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav li + li::before {
    content: "|";
    margin-inline: 0.75rem;
    color: var(--color-gold-dim);
  }

  .site-footer__nav a {
    color: var(--color-muted);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.25s var(--ease-out);
  }

  .site-footer__nav a:hover,
  .site-footer__nav a:focus-visible {
    color: var(--color-gold-bright);
    outline: none;
  }

  .site-footer__meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-footer__social {
    display: flex;
    gap: 0.9rem;
    padding-right: 1.25rem;
    border-right: 1px solid var(--color-line);
  }

  .site-footer__social a {
    display: grid;
    place-items: center;
    color: var(--color-muted);
    transition: color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }

  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    color: var(--color-gold-bright);
    transform: translateY(-2px);
    outline: none;
  }

  .site-footer__url,
  .site-footer__legal {
    color: var(--color-stone);
    font-size: 0.72rem;
  }

  .site-footer__legal {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.66rem;
  }

  @media (max-width: 900px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer__nav li + li::before {
      margin-inline: 0.5rem;
    }
  }
</style>
