---
import Scene from "./scenes/Scene.astro";
import { givingGallery, prosperityGallery } from "../data/site";

/**
 * One shared photo lightbox. Open it from anywhere with
 * `<button data-lightbox="giving" data-index="0">` — the key picks the gallery.
 */
const galleries = { giving: givingGallery, prosperity: prosperityGallery };

// Scenes already drawn on the page (marked with data-gallery-item) are cloned from there;
// only the remaining ones need a template here.
const onPage = new Set(["giving-0", "giving-1", "giving-2", "giving-3", "giving-4", "prosperity-0"]);
---

<dialog class="modal lightbox" data-lightbox-modal aria-label="Photo gallery">
  <script type="application/json" data-lightbox-data set:html={JSON.stringify(galleries)} />
  {
    Object.entries(galleries).flatMap(([key, items]) =>
      items.map((item, i) =>
        item.src || onPage.has(`${key}-${i}`) ? null : (
          <template data-lightbox-scene={`${key}-${i}`}>
            <Scene name={item.scene} seed={i + 3} />
          </template>
        ),
      ),
    )
  }
  <button class="modal__close" type="button" data-lightbox-close aria-label="Close gallery">×</button>

  <figure class="lightbox__figure">
    <div class="lightbox__stage" data-lightbox-stage></div>
    <figcaption class="lightbox__caption">
      <span data-lightbox-caption></span>
      <span class="lightbox__count" data-lightbox-count></span>
    </figcaption>
  </figure>

  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous photo">‹</button>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next photo">›</button>
</dialog>

<style>
  .lightbox {
    overflow: hidden;
  }

  .lightbox__figure {
    margin: 0;
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    height: min(72svh, 640px);
    background: #000;
    touch-action: pan-y;
  }

  .lightbox__stage :global(.lightbox__scene) {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .lightbox__stage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lightbox__stage :global(.lightbox__ph) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 2rem;
    color: var(--color-stone);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-align: center;
    text-transform: uppercase;
    background:
      radial-gradient(ellipse at 30% 25%, rgba(255, 255, 255, 0.1), transparent 55%),
      linear-gradient(160deg, #343434 0%, #1a1a1a 55%, #0d0d0d 100%);
  }

  .lightbox__stage :global(.is-entering) {
    animation: lb-fade 0.4s var(--ease-out);
  }

  .lightbox__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.2rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    border-top: 1px solid var(--color-line);
  }

  .lightbox__count {
    color: var(--color-gold);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    white-space: nowrap;
  }

  .lightbox__nav {
    position: absolute;
    top: calc(min(72svh, 640px) / 2);
    z-index: 2;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: rgba(12, 14, 18, 0.7);
    color: var(--color-white);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .lightbox__nav:hover,
  .lightbox__nav:focus-visible {
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
    outline: none;
  }

  .lightbox__nav--prev { left: 0.8rem; }
  .lightbox__nav--next { right: 0.8rem; }

  @keyframes lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__stage :global(.is-entering) { animation: none; }
  }
</style>

<script>
  import { initScene } from "../scripts/scenes";

  interface Item {
    src: string;
    alt: string;
  }

  const modal = document.querySelector<HTMLDialogElement>("[data-lightbox-modal]");
  const data: Record<string, Item[]> = JSON.parse(
    modal?.querySelector("[data-lightbox-data]")?.textContent ?? "{}",
  );
  const stage = modal?.querySelector<HTMLElement>("[data-lightbox-stage]");
  const caption = modal?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const count = modal?.querySelector<HTMLElement>("[data-lightbox-count]");

  let items: Item[] = [];
  let galleryKey = "";
  let index = 0;

  const render = () => {
    const item = items[index];
    if (!stage || !item) return;
    let node: HTMLElement;
    const key = `${galleryKey}-${index}`;
    const sceneTpl = modal?.querySelector<HTMLTemplateElement>(`[data-lightbox-scene="${key}"]`);
    const pageScene = document.querySelector(`[data-gallery-item="${key}"] [data-scene]`);
    const sceneSource = sceneTpl?.content ?? pageScene;
    if (item.src) {
      const img = document.createElement("img");
      img.src = item.src;
      img.alt = item.alt;
      node = img;
    } else if (sceneSource) {
      node = document.createElement("div");
      node.className = "lightbox__scene";
      node.setAttribute("role", "img");
      node.setAttribute("aria-label", item.alt);
      node.append(sceneSource.cloneNode(true));
      node.querySelectorAll<HTMLElement>("[data-scene]").forEach((scene) => {
        scene.classList.remove("is-hover", "is-playing");
        initScene(scene);
      });
    } else {
      node = document.createElement("div");
      node.className = "lightbox__ph";
      node.textContent = item.alt;
    }
    node.classList.add("is-entering");
    stage.replaceChildren(node);
    if (caption) caption.textContent = item.alt;
    if (count) count.textContent = `${index + 1} / ${items.length}`;
  };

  const go = (step: number) => {
    if (!items.length) return;
    index = (index + step + items.length) % items.length;
    render();
  };

  document.addEventListener("click", (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>("[data-lightbox]");
    if (!trigger || !modal) return;
    galleryKey = trigger.dataset.lightbox ?? "";
    items = data[galleryKey] ?? [];
    if (!items.length) return;
    event.preventDefault();
    index = Number(trigger.dataset.index ?? 0);
    render();
    modal.showModal();
  });

  modal?.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => go(-1));
  modal?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => go(1));
  modal?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => modal.close());
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) modal.close();
  });
  modal?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") go(-1);
    if (event.key === "ArrowRight") go(1);
  });

  // Swipe left/right on touch screens.
  let startX: number | null = null;
  stage?.addEventListener("pointerdown", (event) => {
    startX = event.clientX;
  });
  stage?.addEventListener("pointerup", (event) => {
    if (startX === null) return;
    const dx = event.clientX - startX;
    if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
    startX = null;
  });
</script>
