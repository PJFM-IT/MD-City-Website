---
import { INTRO_VIDEO_URL, SUBTITLE_LANGS, GIVING_URL } from "../data/site";

// Gold dust rising around the film (deterministic so every build looks the same).
let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const dust = Array.from({ length: 40 }, () => {
  // Weighted towards the left/right edges, where the space beside the film is.
  const r = rand();
  const left = r < 0.42 ? rand() * 15 : r < 0.84 ? 85 + rand() * 15 : rand() * 100;
  return `left:${left.toFixed(1)}%;--s:${(1.5 + rand() * 3.5).toFixed(1)}px;--x:${(rand() * 70 - 35).toFixed(0)}px;--t:${(10 + rand() * 10).toFixed(1)}s;--d:${(-rand() * 20).toFixed(1)}s`;
});
---

{
  INTRO_VIDEO_URL && (
    <section class="intro theme-dark" id="watch" data-intro aria-label="Miracle Dome City film">
      <!-- Atmosphere, back to front: the film's own colours, light rays, heaven glow, gold dust, vignette. -->
      <canvas class="intro__ambient" data-intro-ambient width="160" height="90" aria-hidden="true"></canvas>
      <div class="intro__rays" aria-hidden="true"></div>
      <div class="intro__heaven" aria-hidden="true"></div>
      <div class="intro__dust" aria-hidden="true">
        {dust.map((style) => <span style={style} />)}
      </div>
      <div class="intro__vignette" aria-hidden="true"></div>

      <div class="intro__stage" data-intro-stage>
        <!-- Side panels (wide screens, when there is room beside the film). -->
        <div class="intro__panel intro__panel--left" aria-hidden="true">
          <span class="intro__ornament"></span>
          <span class="intro__rule"></span>
          <p class="intro__vtext">Miracle Dome City</p>
          <span class="intro__rule"></span>
          <span class="intro__ornament"></span>
        </div>
        <div class="intro__panel intro__panel--right" aria-hidden="true">
          <span class="intro__ornament"></span>
          <span class="intro__rule"></span>
          <p class="intro__vtext">Where Heaven Meets Earth</p>
          <span class="intro__rule"></span>
          <span class="intro__ornament"></span>
        </div>

        <!-- Phones: a small title block above the film. -->
        <div class="intro__mtitle" aria-hidden="true">
          <span class="intro__ornament"></span>
          <p class="intro__mtitle-name">Miracle Dome City</p>
          <p class="intro__mtitle-tag">Where Heaven Meets Earth</p>
        </div>

        <!-- Two-sided card: the film on the front; when it ends the card turns over to the Giving
             invitation on the back, then turns back and the film plays again. -->
        <div class="intro__flip" data-intro-flip>
          <video
            class="intro__video"
            data-intro-video
            data-src={INTRO_VIDEO_URL}
            data-src-mobile={INTRO_VIDEO_URL.replace(/\.mp4$/, "-mobile.mp4")}
            poster="/videos/intro-poster.jpg"
            playsinline
            preload="auto"
          >
            {
              SUBTITLE_LANGS.map((l) => (
                <track kind="subtitles" srclang={l.code} label={l.name} src={`/subtitles/intro.${l.code}.vtt`} />
              ))
            }
          </video>

          <div class="intro__back" data-intro-back aria-hidden="true">
            <div class="intro__back-inner">
              <span class="intro__ornament"></span>
              <h2 class="intro__back-title">Be a Part of the Miracle</h2>
              <a class="btn btn--solid intro__back-btn" href={GIVING_URL} target="_blank" rel="noopener" tabindex="-1">
                Giving
              </a>
            </div>
            <span class="intro__back-timer" aria-hidden="true"><span data-intro-timer></span></span>
          </div>
        </div>

        <!-- Gold frame: hairlines, glowing corners and diamond accents. -->
        <div class="intro__frame" aria-hidden="true">
          <span class="intro__corner intro__corner--tl"></span>
          <span class="intro__corner intro__corner--tr"></span>
          <span class="intro__corner intro__corner--bl"></span>
          <span class="intro__corner intro__corner--br"></span>
          <span class="intro__gem intro__gem--a"></span>
          <span class="intro__gem intro__gem--b"></span>
        </div>

        <!-- Translated subtitles sit just above the video's own (burned-in) English captions. -->
        <p class="intro__subs" data-intro-subs aria-live="polite" hidden></p>

        <label class="intro__lang">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M7 11h4M13 11h4M7 15h6M15 15h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <select data-intro-lang aria-label="Subtitle language">
            <option value="">Subtitles off</option>
            {SUBTITLE_LANGS.map((l) => <option value={l.code}>{l.name}</option>)}
          </select>
        </label>

        <div class="intro__progress" aria-hidden="true">
          <span data-intro-progress />
        </div>
      </div>
    </section>
  )
}

{
  INTRO_VIDEO_URL && (
    <div class="intro-gate" data-intro-gate role="dialog" aria-modal="true" aria-label="Welcome to Miracle Dome City" hidden>
      <img class="intro-gate__bg" src="/videos/intro-poster.jpg" alt="" aria-hidden="true" />
      <div class="intro-gate__rays" aria-hidden="true"></div>
      <div class="intro-gate__glow" aria-hidden="true"></div>

      <div class="intro-gate__inner">
        <img
          class="intro-gate__logo"
          src="/images/mdc-logo-light.webp"
          alt="Miracle Dome City — Where Heaven Meets Earth"
          width="640"
          height="450"
        />
        <span class="intro-gate__rule" aria-hidden="true"></span>
        <button class="intro-gate__enter" type="button" data-intro-enter>
          <span>Enter Miracle Dome City</span>
        </button>
      </div>
    </div>
  )
}

<script is:inline>
  // Show the welcome screen straight away (before the rest of the page paints), unless the visitor
  // came in on a link to a later section.
  (function () {
    var g = document.querySelector("[data-intro-gate]");
    var h = location.hash;
    if (!g || (h && h !== "#watch" && h !== "#top")) return;
    g.hidden = false;
    document.documentElement.classList.add("intro-gated");
  })();
</script>

<script is:inline>
  // Pick the file before the browser starts downloading: phones get the lighter 480p version.
  (function () {
    var v = document.querySelector("[data-intro-video]");
    if (!v) return;
    var small = window.matchMedia("(max-width: 900px)").matches;
    v.src = (small && v.dataset.srcMobile) || v.dataset.src;
  })();
</script>

<style>
  /* First section of the page. The film fills the space below the header and is always shown whole
     (never cropped). Around it, back to front: a blurred glow of the film's own colours, slowly
     turning light rays, a gold "heaven light", rising gold dust and a vignette. On wide screens two
     side panels carry the name, tagline and playback timecode. */
  .intro {
    --gold-hi: #f1d488;
    --gold-line: rgba(201, 164, 92, 0.55);
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100svh;
    min-height: 22rem;
    padding-top: var(--header-h);
    overflow: hidden;
    background: #000;
  }

  /* ---------- Atmosphere ---------- */
  .intro__ambient,
  .intro__heaven,
  .intro__dust,
  .intro__vignette {
    position: absolute;
    inset: var(--header-h) 0 0;
    pointer-events: none;
  }

  .intro__ambient {
    width: 100%;
    height: calc(100% - var(--header-h));
    filter: brightness(0.5) saturate(1.1);
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  .intro__ambient.is-on {
    opacity: 1;
  }

  /* Fine rays fanning out from behind the top of the film, turning very slowly. */
  .intro__rays {
    position: absolute;
    top: var(--header-h);
    left: 50%;
    width: 220vmax;
    height: 220vmax;
    background: repeating-conic-gradient(
      from 0deg,
      rgba(241, 212, 136, 0.075) 0deg 2.2deg,
      transparent 2.2deg 9deg
    );
    -webkit-mask-image: radial-gradient(closest-side, #000 0%, rgba(0, 0, 0, 0.55) 22%, transparent 48%);
    mask-image: radial-gradient(closest-side, #000 0%, rgba(0, 0, 0, 0.55) 22%, transparent 48%);
    transform: translate(-50%, -50%);
    animation: intro-rays 180s linear infinite;
    pointer-events: none;
  }

  @keyframes intro-rays {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .intro__heaven {
    background:
      radial-gradient(ellipse 50% 55% at 50% 0%, rgba(241, 212, 136, 0.26), transparent 70%),
      radial-gradient(ellipse 40% 70% at 50% 110%, rgba(201, 164, 92, 0.1), transparent 70%);
    animation: intro-breathe 8s ease-in-out infinite;
  }

  @keyframes intro-breathe {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  .intro__dust {
    overflow: hidden;
  }

  .intro__dust span {
    position: absolute;
    bottom: -12px;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle, #fff1c4 0%, rgba(241, 212, 136, 0.65) 40%, rgba(241, 212, 136, 0) 70%);
    opacity: 0;
    animation: intro-rise var(--t) linear var(--d) infinite;
  }

  @keyframes intro-rise {
    0% { transform: translate3d(0, 0, 0); opacity: 0; }
    12% { opacity: 0.9; }
    80% { opacity: 0.5; }
    100% { transform: translate3d(var(--x), -95svh, 0); opacity: 0; }
  }

  .intro__vignette {
    background: radial-gradient(ellipse 75% 85% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.6) 100%);
  }

  /* ---------- The film ---------- */
  /* Exactly 16:9 and as large as fits below the header, so subtitles, frame and controls line up
     with the picture itself. */
  .intro__stage {
    position: relative;
    z-index: 2;
    width: min(100%, calc((100svh - var(--header-h)) * 16 / 9));
    aspect-ratio: 16 / 9;
  }

  .intro__stage {
    perspective: 2200px;
  }

  /* ---------- The turning card ---------- */
  .intro__flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1.3s cubic-bezier(0.65, 0, 0.25, 1);
  }

  .intro.is-flipped .intro__flip {
    transform: rotateY(180deg);
  }

  .intro.is-flipped .intro__back {
    pointer-events: auto;
  }

  .intro__video,
  .intro__back {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .intro__back {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    display: grid;
    place-items: center;
    overflow: hidden;
    transform: rotateY(180deg);
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(241, 212, 136, 0.22), transparent 70%),
      linear-gradient(180deg, rgba(8, 9, 12, 0.8), rgba(8, 9, 12, 0.95)),
      url("/videos/intro-poster.jpg") center / cover no-repeat,
      #0a0907;
    box-shadow:
      0 0 0 1px rgba(201, 164, 92, 0.35),
      0 30px 80px rgba(0, 0, 0, 0.6);
    text-align: center;
  }

  .intro__back-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.4rem, 1.6cqw, 1.1rem);
    max-width: min(46rem, 84%);
  }

  /* Content rises in once the card has turned. */
  .intro__back-inner > * {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  }

  .intro.is-flipped .intro__back-inner > * {
    opacity: 1;
    transform: none;
  }

  .intro.is-flipped .intro__back-inner > :nth-child(1) { transition-delay: 0.9s; }
  .intro.is-flipped .intro__back-inner > :nth-child(2) { transition-delay: 1s; }
  .intro.is-flipped .intro__back-inner > :nth-child(3) { transition-delay: 1.15s; }
  .intro.is-flipped .intro__back-inner > :nth-child(4) { transition-delay: 1.3s; }
  .intro.is-flipped .intro__back-inner > :nth-child(5) { transition-delay: 1.45s; }

  .intro__back-inner > .intro__ornament {
    transform: translateY(14px) rotate(45deg);
  }

  .intro.is-flipped .intro__back-inner > .intro__ornament {
    transform: rotate(45deg);
  }

  .intro__back-eyebrow {
    margin: 0;
    color: var(--gold-hi);
    font-size: clamp(0.55rem, 1.35cqw, 0.8rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .intro__back-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 4.6cqw, 3.2rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.04em;
    background: linear-gradient(180deg, #fbe9b4 0%, var(--gold-hi) 45%, #b8914c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 18px rgba(241, 212, 136, 0.25));
  }

  .intro__back-text {
    margin: 0;
    max-width: 36rem;
    color: rgba(244, 241, 236, 0.82);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.85rem, 2.1cqw, 1.35rem);
    line-height: 1.5;
  }

  .intro__back-btn {
    margin-top: clamp(0.2rem, 1cqw, 0.75rem);
    min-width: clamp(8rem, 18cqw, 12rem);
    animation: intro-pulse 2.6s ease-in-out infinite;
  }

  /* Small screens: keep it to the heading and the button. */
  @container (max-width: 520px) {
    .intro__back-text {
      display: none;
    }
  }

  /* Gold line along the bottom: time left before the film plays again. */
  .intro__back-timer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.08);
  }

  .intro__back-timer span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #b8914c, var(--gold-hi));
    transform: scaleX(0);
    transform-origin: left;
  }

  .intro.is-flipped .intro__back-timer span {
    transform: scaleX(1);
    transition: transform var(--back-ms, 10000ms) linear 1.3s;
  }

  /* Subtitles, sound note and progress belong to the film side. */
  .intro.is-flipped .intro__subs,
  .intro.is-flipped .intro__hint,
  .intro.is-flipped .intro__progress {
    visibility: hidden;
  }

  .intro__lang {
    transition: opacity 0.5s var(--ease-out), border-color 0.25s var(--ease-out), background 0.25s var(--ease-out);
  }

  .intro.is-flipped .intro__lang {
    opacity: 0;
    pointer-events: none;
  }

  .intro__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    box-shadow:
      0 0 0 1px rgba(201, 164, 92, 0.25),
      0 30px 80px rgba(0, 0, 0, 0.6);
  }

  /* Subtitles are drawn by .intro__subs; hide the browser's own rendering if it shows any. */
  .intro__video::cue {
    color: transparent;
    background: transparent;
  }

  /* ---------- Gold frame ---------- */
  /* Hairlines run along the sides that have room around them; wherever the film touches the header
     or the screen edge, the frame tucks just inside it. */
  .intro__frame {
    --fx: 10px; /* left/right offset (inside the film unless there's room beside it) */
    --fy: 10px; /* top/bottom offset (inside the film unless there's room above/below) */
    position: absolute;
    inset: var(--fy) var(--fx);
    border: 0 solid var(--gold-line);
    pointer-events: none;
    animation: intro-frame-in 1.8s var(--ease-out) 0.15s both;
  }

  .intro.room-x .intro__frame {
    --fx: -14px;
    border-left-width: 1px;
    border-right-width: 1px;
  }

  .intro.room-y .intro__frame {
    --fy: -14px;
    border-top-width: 1px;
    border-bottom-width: 1px;
  }

  @keyframes intro-frame-in {
    from {
      opacity: 0;
      clip-path: inset(48% 48% 48% 48%);
    }
    to {
      opacity: 1;
      clip-path: inset(-20px -20px -20px -20px);
    }
  }

  .intro__corner {
    position: absolute;
    width: clamp(16px, 1.8vw, 28px);
    height: clamp(16px, 1.8vw, 28px);
    border: 0 solid var(--gold-hi);
    filter: drop-shadow(0 0 5px rgba(241, 212, 136, 0.75));
  }

  .intro__corner--tl { top: -1px; left: -1px; border-width: 1.5px 0 0 1.5px; }
  .intro__corner--tr { top: -1px; right: -1px; border-width: 1.5px 1.5px 0 0; }
  .intro__corner--bl { bottom: -1px; left: -1px; border-width: 0 0 1.5px 1.5px; }
  .intro__corner--br { bottom: -1px; right: -1px; border-width: 0 1.5px 1.5px 0; }

  /* Small diamonds in the middle of the two visible hairlines. */
  .intro__gem {
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold-hi);
    background: #0b0b0d;
    box-shadow: 0 0 10px rgba(241, 212, 136, 0.6);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .intro__gem { display: none; }
  .intro.room-x .intro__gem { display: block; }
  .intro.room-x .intro__gem--a { top: 50%; left: -0.5px; }
  .intro.room-x .intro__gem--b { top: 50%; left: calc(100% + 0.5px); }
  .intro.room-y:not(.room-x) .intro__gem { display: block; }
  .intro.room-y:not(.room-x) .intro__gem--a { top: -0.5px; left: 50%; }
  .intro.room-y:not(.room-x) .intro__gem--b { top: calc(100% + 0.5px); left: 50%; }

  /* ---------- Side panels ---------- */
  .intro__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--side, 0px);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.4vh, 1.6rem);
    pointer-events: none;
  }

  .intro__panel--left { right: 100%; }
  .intro__panel--right { left: 100%; }

  .intro.has-sides .intro__panel {
    display: flex;
    animation: intro-panel-in 1.6s var(--ease-out) 0.5s both;
  }

  .intro.has-sides .intro__panel--right {
    animation-delay: 0.7s;
  }

  @keyframes intro-panel-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .intro__vtext {
    margin: 0;
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 1.55vh, 0.98rem);
    font-weight: 500;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    background: linear-gradient(180deg, #fbe9b4 0%, var(--gold-hi) 35%, #b8914c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 12px rgba(241, 212, 136, 0.35));
  }

  /* The left inscription reads upwards, the right one downwards — like a book spine on each side. */
  .intro__panel--left .intro__vtext {
    transform: rotate(180deg);
  }

  .intro__rule {
    width: 1px;
    height: clamp(1.75rem, 6vh, 3.75rem);
    background: linear-gradient(180deg, transparent, var(--gold-line), transparent);
  }

  .intro__ornament {
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold-hi);
    box-shadow: 0 0 10px rgba(241, 212, 136, 0.6);
    transform: rotate(45deg);
  }

  /* Short wide screens: keep the panels from overflowing. */
  @media (max-height: 700px) {
    .intro__panel--right .intro__rule,
    .intro__panel--left .intro__rule {
      display: none;
    }
  }

  /* ---------- Phone title ---------- */
  .intro__mtitle {
    display: none;
  }

  /* ---------- Subtitles & controls ---------- */
  .intro__subs {
    position: absolute;
    z-index: 3;
    left: 50%;
    /* Just above the video's own captions (they sit in the bottom ~18% of the frame). */
    bottom: 17%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 86%;
    margin: 0;
    padding: 0.3em 0.8em;
    border-radius: 0.35em;
    background: rgba(8, 10, 13, 0.78);
    color: #fff;
    font-family: var(--font-body), "Nirmala UI", "Noto Sans Sinhala", "Noto Sans Tamil", "Noto Sans Devanagari",
      "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
    font-size: clamp(0.8rem, 2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.45;
    text-align: center;
    pointer-events: none;
  }

  .intro__hint,
  .intro__lang {
    position: absolute;
    z-index: 3;
    top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.3rem;
    padding: 0 1rem;
    border: 1px solid rgba(201, 164, 92, 0.5);
    border-radius: 999px;
    background: rgba(10, 11, 14, 0.62);
    backdrop-filter: blur(10px);
    color: var(--color-white);
    font-family: var(--font-body);
    cursor: pointer;
    transition: border-color 0.25s var(--ease-out), background 0.25s var(--ease-out);
  }

  .intro__hint:hover,
  .intro__hint:focus-visible,
  .intro__lang:hover,
  .intro__lang:focus-within {
    border-color: var(--gold-hi);
    background: rgba(10, 11, 14, 0.8);
    outline: none;
  }

  /* Only shown when the browser blocked sound: any tap/click on the page turns it on. */
  .intro__hint {
    left: 1rem;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    animation: intro-pulse 2.6s ease-in-out 1s infinite;
  }

  .intro__hint[hidden] {
    display: none;
  }

  @keyframes intro-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(241, 212, 136, 0.4); }
    50% { box-shadow: 0 0 0 8px rgba(241, 212, 136, 0); }
  }

  .intro__lang {
    right: 1rem;
  }

  .intro__lang select {
    appearance: none;
    padding: 0 1rem 0 0;
    border: 0;
    background: transparent;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      right 0.35rem center,
      right 0.05rem center;
    background-size: 0.3rem 0.3rem;
    background-repeat: no-repeat;
    color: inherit;
    font-family: var(--font-body), "Nirmala UI", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    outline: none;
  }

  .intro__lang option {
    color: #0c0e12;
    background: #f4f1ec;
  }

  /* Thin progress line along the bottom of the film (smaller screens only; hidden beside the side
     panels on wide screens). */
  .intro__progress {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
  }

  .intro__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #b8914c, var(--gold-hi));
    transform: scaleX(0);
    transform-origin: left;
  }

  .intro.has-sides .intro__progress {
    display: none;
  }

  /* ---------- Upright phones ---------- */
  /* Full-width film in the middle of the screen: title block and sound note above, subtitle picker
     below. */
  @media (max-aspect-ratio: 1/1) {
    .intro__mtitle {
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(100% + 4.75rem);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.55rem;
      text-align: center;
      pointer-events: none;
      animation: intro-panel-in 1.4s var(--ease-out) 0.3s both;
    }

    .intro__mtitle-name {
      margin: 0.35rem 0 0;
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      background: linear-gradient(180deg, #fbe9b4, var(--gold-hi) 45%, #b8914c);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .intro__mtitle-tag {
      margin: 0;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 1.05rem;
      color: rgba(244, 241, 236, 0.75);
    }

    .intro__subs {
      bottom: 19%;
      font-size: 0.75rem;
    }

    .intro__hint {
      top: auto;
      bottom: calc(100% + 1.1rem);
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
    }

    .intro__lang {
      top: calc(100% + 1.1rem);
      right: auto;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  /* ---------- Welcome screen ---------- */
  :global(html.intro-gated),
  :global(html.intro-gated body) {
    overflow: hidden;
  }

  .intro-gate {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    overflow: hidden;
    background: #050403;
    transition: opacity 1.1s var(--ease-out), visibility 0s linear 1.1s;
  }

  .intro-gate[hidden] {
    display: none;
  }

  .intro-gate.is-leaving {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .intro-gate__bg {
    position: absolute;
    inset: -40px;
    width: calc(100% + 80px);
    height: calc(100% + 80px);
    object-fit: cover;
    filter: blur(18px) brightness(0.22) saturate(1.1);
    transform: scale(1.08);
    animation: gate-drift 24s ease-in-out infinite alternate;
  }

  @keyframes gate-drift {
    to { transform: scale(1.18) translate(-1.5%, -1%); }
  }

  .intro-gate__rays {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 220vmax;
    height: 220vmax;
    background: repeating-conic-gradient(
      from 0deg,
      rgba(241, 212, 136, 0.07) 0deg 2.2deg,
      transparent 2.2deg 9deg
    );
    -webkit-mask-image: radial-gradient(closest-side, #000 0%, rgba(0, 0, 0, 0.5) 20%, transparent 45%);
    mask-image: radial-gradient(closest-side, #000 0%, rgba(0, 0, 0, 0.5) 20%, transparent 45%);
    transform: translate(-50%, -50%);
    animation: gate-rays 160s linear infinite;
  }

  @keyframes gate-rays {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .intro-gate__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 40% at 50% 45%, rgba(241, 212, 136, 0.18), transparent 70%),
      radial-gradient(ellipse 90% 90% at 50% 50%, transparent 50%, rgba(0, 0, 0, 0.75) 100%);
  }

  .intro-gate__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 3.5vh, 2rem);
    text-align: center;
  }

  .intro-gate__inner > * {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1.1s var(--ease-out), transform 1.1s var(--ease-out);
  }

  .intro-gate.is-in .intro-gate__inner > * {
    opacity: 1;
    transform: none;
  }

  .intro-gate.is-in .intro-gate__inner > :nth-child(2) { transition-delay: 0.35s; }
  .intro-gate.is-in .intro-gate__inner > :nth-child(3) { transition-delay: 0.55s; }
  .intro-gate.is-in .intro-gate__inner > :nth-child(4) { transition-delay: 0.8s; }

  .intro-gate.is-leaving .intro-gate__inner > * {
    transform: scale(1.04);
  }

  .intro-gate__logo {
    width: clamp(11rem, 26vw, 19rem);
    height: auto;
    filter: drop-shadow(0 0 30px rgba(241, 212, 136, 0.25));
  }

  .intro-gate__rule {
    width: clamp(5rem, 14vw, 9rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-hi, #f1d488), transparent);
  }

  .intro-gate__enter {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.4rem;
    padding: 0 clamp(1.6rem, 4vw, 2.8rem);
    border: 1px solid rgba(241, 212, 136, 0.75);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(241, 212, 136, 0.16), rgba(201, 164, 92, 0.06));
    color: #fbe9b4;
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 1.6vw, 0.98rem);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    cursor: pointer;
    overflow: hidden;
    animation: gate-pulse 2.8s ease-in-out 1.6s infinite;
    transition: background 0.35s var(--ease-out), color 0.35s var(--ease-out), border-color 0.35s var(--ease-out);
  }

  /* A soft sheen sweeping across the button. */
  .intro-gate__enter::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 35%, rgba(255, 244, 210, 0.35) 50%, transparent 65%);
    transform: translateX(-120%);
    animation: gate-sheen 4.5s ease-in-out 2s infinite;
  }

  .intro-gate__enter span {
    position: relative;
  }

  .intro-gate__enter:hover,
  .intro-gate__enter:focus-visible {
    background: linear-gradient(180deg, #f1d488, #c9a45c);
    border-color: #f1d488;
    color: #14110b;
    outline: none;
  }

  @keyframes gate-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(241, 212, 136, 0.35), 0 0 30px rgba(241, 212, 136, 0.12); }
    50% { box-shadow: 0 0 0 12px rgba(241, 212, 136, 0), 0 0 40px rgba(241, 212, 136, 0.2); }
  }

  @keyframes gate-sheen {
    0% { transform: translateX(-120%); }
    40%, 100% { transform: translateX(120%); }
  }

  .intro-gate__note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: rgba(244, 241, 236, 0.6);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (max-width: 480px) {
    .intro-gate__enter {
      letter-spacing: 0.18em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-gate__bg,
    .intro-gate__rays,
    .intro-gate__enter,
    .intro-gate__enter::before {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__hint,
    .intro__heaven,
    .intro__rays,
    .intro__frame,
    .intro.has-sides .intro__panel,
    .intro__mtitle,
    .intro__back-btn {
      animation: none;
    }

    /* Cross-fade instead of turning. */
    .intro__flip,
    .intro.is-flipped .intro__flip {
      transform: none;
    }

    .intro__back {
      transform: none;
      opacity: 0;
      transition: opacity 0.6s;
    }

    .intro.is-flipped .intro__back {
      opacity: 1;
    }

    .intro__dust {
      display: none;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>("[data-intro]");
  const video = intro?.querySelector<HTMLVideoElement>("[data-intro-video]");

  if (intro && video) {
    const bar = intro.querySelector<HTMLElement>("[data-intro-progress]");
    const stage = intro.querySelector<HTMLElement>("[data-intro-stage]");
    // ----- Progress line along the bottom of the film -----
    video.addEventListener("timeupdate", () => {
      if (bar && video.duration) bar.style.transform = `scaleX(${video.currentTime / video.duration})`;
    });

    // ----- Layout: side panels only when there is real room beside the film -----
    // The frame's hairlines go wherever there is room around the film (room-x / room-y).
    const checkSides = () => {
      if (!stage) return;
      const side = (intro.clientWidth - stage.clientWidth) / 2;
      const top = parseFloat(getComputedStyle(intro).paddingTop) || 0;
      const above = (intro.clientHeight - top - stage.clientHeight) / 2;
      intro.style.setProperty("--side", `${Math.max(0, side)}px`);
      intro.classList.toggle("has-sides", side >= 110);
      intro.classList.toggle("room-x", side >= 24);
      intro.classList.toggle("room-y", above >= 24);
    };

    // ----- Ambient glow -----
    // A small canvas (160px wide) gets the current frame ~15 times a second, blurred; the browser
    // scales it up to fill the section, which keeps it soft and very cheap to draw.
    const ambient = intro.querySelector<HTMLCanvasElement>("[data-intro-ambient]");
    const actx = ambient?.getContext("2d", { alpha: false });

    const sizeAmbient = () => {
      if (!ambient) return;
      const r = ambient.getBoundingClientRect();
      if (!r.width || !r.height) return;
      ambient.width = 160;
      ambient.height = Math.max(8, Math.round((160 * r.height) / r.width));
    };

    const drawAmbient = () => {
      if (!ambient || !actx || video.readyState < 2 || !video.videoWidth) return;
      const cw = ambient.width;
      const ch = ambient.height;
      // "cover" crop of the video into the canvas.
      const scale = Math.max(cw / video.videoWidth, ch / video.videoHeight);
      const sw = cw / scale;
      const sh = ch / scale;
      const sx = (video.videoWidth - sw) / 2;
      const sy = (video.videoHeight - sh) / 2;
      actx.filter = "blur(4px)";
      actx.drawImage(video, sx, sy, sw, sh, 0, 0, cw, ch);
      actx.filter = "none";
      ambient.classList.add("is-on");
    };

    sizeAmbient();
    checkSides();
    window.addEventListener("resize", () => {
      sizeAmbient();
      checkSides();
    });
    video.addEventListener("loadeddata", drawAmbient);
    video.addEventListener("seeked", drawAmbient);
    // Checks the video's real state each tick instead of relying on play/pause events (a blocked
    // attempt to play with sound can report "pause" after the muted fallback has already started).
    window.setInterval(() => {
      if (!video.paused && !document.hidden && intro.getBoundingClientRect().bottom > 0) drawAmbient();
    }, 66);

    // ----- Sound + scrolling -----
    // The film loops continuously with sound while it's on screen. Scrolling down mutes it
    // automatically; scrolling back up brings the sound back. Once it's completely off screen it
    // also pauses (nobody can see it, and it keeps the rest of the site smooth), and carries on
    // when the visitor comes back.
    //
    // Browsers block sound until the visitor has interacted with the page. If that happens, the
    // film plays muted with a small "Tap anywhere for sound" note, and the sound switches on at
    // the first click, tap or key press anywhere.
    let soundAllowed = false; // has the browser let us play with sound yet?
    let mostlyInView = true; // at least half of the film section on screen
    let onScreen = true; // any of it on screen
    let flipped = false; // showing the Giving side of the card
    let gated = false; // the "Enter Miracle Dome City" welcome screen is up

    const apply = () => {
      video.muted = !(soundAllowed && mostlyInView);
      if (video.muted === false) video.volume = 1;
      if (flipped || gated) return;
      if (onScreen && video.paused) video.play().catch(() => {});
      else if (!onScreen && !video.paused) video.pause();
    };

    const allowSound = () => {
      soundAllowed = true;
      apply();
    };


    const armSoundOnFirstInteraction = () => {
      const events = ["pointerdown", "keydown", "touchend"] as const;
      const onFirst = () => {
        events.forEach((type) => document.removeEventListener(type, onFirst, true));
        allowSound();
      };
      events.forEach((type) => document.addEventListener(type, onFirst, true));
    };

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          mostlyInView = entry.intersectionRatio >= 0.5;
          onScreen = entry.isIntersecting;
          apply();
        },
        { threshold: [0, 0.5, 1] },
      ).observe(intro);
    }

    // ----- End of the film: turn the card over to the Giving invitation, then back again -----
    const back = intro.querySelector<HTMLElement>("[data-intro-back]");
    const backBtn = back?.querySelector<HTMLAnchorElement>("a");
    const FLIP_MS = 1300; // matches the CSS turn
    const BACK_MS = 10000; // how long the Giving side stays
    let backTimer = 0;
    let backLeft = BACK_MS;
    let backStarted = 0;
    intro.style.setProperty("--back-ms", `${BACK_MS}ms`);

    const flipToFilm = () => {
      window.clearTimeout(backTimer);
      intro.classList.remove("is-flipped");
      back?.setAttribute("aria-hidden", "true");
      backBtn?.setAttribute("tabindex", "-1");
      video.currentTime = 0;
      if (bar) bar.style.transform = "scaleX(0)";
      // Start the film again as the card comes round.
      window.setTimeout(() => {
        flipped = false;
        apply();
      }, FLIP_MS * 0.5);
    };

    // The countdown only runs while the visitor can actually see the card.
    const runBackTimer = () => {
      window.clearTimeout(backTimer);
      backStarted = Date.now();
      backTimer = window.setTimeout(flipToFilm, backLeft);
    };

    const flipToGiving = () => {
      flipped = true;
      backLeft = BACK_MS + FLIP_MS;
      intro.classList.add("is-flipped");
      back?.setAttribute("aria-hidden", "false");
      backBtn?.removeAttribute("tabindex");
      if (onScreen) runBackTimer();
    };

    video.addEventListener("ended", flipToGiving);

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        if (!flipped) return;
        if (entry.isIntersecting) runBackTimer();
        else {
          window.clearTimeout(backTimer);
          backLeft = Math.max(1500, backLeft - (Date.now() - backStarted));
        }
      }).observe(intro);
    }

    const startPlayback = () => {
      video.muted = false;
      video
        .play()
        .then(() => {
          soundAllowed = true;
          apply();
        })
        .catch(() => {
          soundAllowed = false;
          video.muted = true;
          video.play().catch(() => {});
          apply();
          armSoundOnFirstInteraction();
        });
    };

    // ----- Subtitles -----
    // The chosen language's track is loaded (mode "hidden") and its current cue drawn in .intro__subs.
    // Defaults to the visitor's browser language when available; remembers the choice.
    const langSelect = intro.querySelector<HTMLSelectElement>("[data-intro-lang]");
    const subs = intro.querySelector<HTMLElement>("[data-intro-subs]");
    const tracks = Array.from(video.textTracks);

    const renderCue = (track: TextTrack) => {
      if (!subs || track.mode !== "hidden") return;
      const cue = track.activeCues?.[0] as VTTCue | undefined;
      subs.textContent = cue?.text ?? "";
      subs.hidden = !cue;
    };

    const setLang = (code: string) => {
      tracks.forEach((t) => {
        t.mode = t.language === code ? "hidden" : "disabled";
      });
      if (subs) {
        subs.hidden = true;
        subs.lang = code;
      }
      const active = tracks.find((t) => t.language === code);
      if (active) renderCue(active);
      try {
        localStorage.setItem("mdc-subs-lang", code);
      } catch {}
    };

    tracks.forEach((t) => t.addEventListener("cuechange", () => renderCue(t)));

    if (langSelect) {
      const available = new Set(tracks.map((t) => t.language));
      let initial = "";
      try {
        const saved = localStorage.getItem("mdc-subs-lang");
        if (saved !== null) initial = saved;
        else {
          const browser = (navigator.language || "").slice(0, 2).toLowerCase();
          if (available.has(browser)) initial = browser;
        }
      } catch {}
      if (!available.has(initial)) initial = "";
      langSelect.value = initial;
      setLang(initial);
      langSelect.addEventListener("change", () => setLang(langSelect.value));
    }

    // ----- Welcome screen -----
    // Browsers only allow sound after the visitor has pressed something, so the site opens on a
    // welcome screen. Pressing "Enter Miracle Dome City" starts the film from the beginning with
    // full sound. Visitors arriving on a link to a later section (e.g. /#contact) skip it.
    const gate = document.querySelector<HTMLElement>("[data-intro-gate]");
    const enter = gate?.querySelector<HTMLButtonElement>("[data-intro-enter]");
    if (gate && enter && !gate.hidden) {
      gated = true;
      requestAnimationFrame(() => gate.classList.add("is-in"));
      enter.focus({ preventScroll: true });

      enter.addEventListener(
        "click",
        () => {
          gated = false;
          soundAllowed = true;
          video.currentTime = 0;
          video.muted = false;
          video.volume = 1;
          // Called directly inside the click, so the browser allows sound.
          video.play().catch(() => {
            soundAllowed = false;
            video.muted = true;
            video.play().catch(() => {});
            armSoundOnFirstInteraction();
          });
          apply();
          gate.classList.add("is-leaving");
          document.documentElement.classList.remove("intro-gated");
          window.setTimeout(() => gate.remove(), 1200);
        },
        { once: true },
      );
    } else {
      gate?.remove();
      startPlayback();
    }
  }
</script>
