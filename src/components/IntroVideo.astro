---
import { INTRO_VIDEO_URL, GIVING_URL, SUBTITLE_LANGS } from "../data/site";
---

{
  INTRO_VIDEO_URL && (
    <div
      class="intro theme-dark"
      data-intro
      role="dialog"
      aria-modal="true"
      aria-label="Welcome to Miracle Dome City"
    >
      <div class="intro__stage">
        <video
          class="intro__video"
          data-intro-video
          data-src={INTRO_VIDEO_URL}
          data-src-mobile={INTRO_VIDEO_URL.replace(/\.mp4$/, "-mobile.mp4")}
          poster="/videos/intro-poster.jpg"
          playsinline
          preload="auto"
        >
          {
            SUBTITLE_LANGS.map((l) => (
              <track kind="subtitles" srclang={l.code} label={l.name} src={`/subtitles/intro.${l.code}.vtt`} />
            ))
          }
        </video>
        <!-- Translated subtitles sit just above the video's own (burned-in) English captions. -->
        <p class="intro__subs" data-intro-subs aria-live="polite" hidden></p>
      </div>

      <div class="intro__bar">
        <button class="intro__chip intro__sound" type="button" data-intro-sound aria-pressed="false">
          <svg class="intro__sound-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
            <path class="intro__sound-waves" d="M16 8.5a4.5 4.5 0 0 1 0 7M18.5 6a8 8 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <path class="intro__sound-mute" d="M16.5 9.5l5 5M21.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span data-intro-sound-label>Sound on</span>
        </button>

        <label class="intro__chip intro__lang">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M7 11h4M13 11h4M7 15h6M15 15h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <select data-intro-lang aria-label="Subtitle language">
            <option value="">Subtitles off</option>
            {SUBTITLE_LANGS.map((l) => <option value={l.code}>{l.name}</option>)}
          </select>
        </label>

        <span class="intro__spacer" />

        <a class="intro__chip" href={GIVING_URL} target="_blank" rel="noopener">Giving</a>
        <button class="intro__chip intro__chip--solid" type="button" data-intro-close>
          Enter the site <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

      <div class="intro__progress" aria-hidden="true">
        <span data-intro-progress />
      </div>
    </div>
  )
}

<script is:inline>
  // Runs immediately so returning visitors (same browser session) never see the intro flash.
  (function () {
    var el = document.querySelector("[data-intro]");
    if (!el) return;
    var seen = false;
    try {
      seen = sessionStorage.getItem("mdc-intro-seen") === "1";
    } catch (e) {}
    if (seen) {
      el.remove();
    } else {
      document.documentElement.classList.add("intro-open");
      // Phones and small screens get the lighter 480p file (~3.7 MB); everything else the 720p (~6.9 MB).
      var v = el.querySelector("[data-intro-video]");
      if (v) {
        var small = window.matchMedia("(max-width: 900px)").matches;
        v.src = (small && v.dataset.srcMobile) || v.dataset.src;
      }
    }
  })();
</script>

<style>
  :global(html.intro-open),
  :global(html.intro-open body) {
    overflow: hidden;
  }

  /* The intro covers the screen: stop the browser painting/animating the page underneath so all
     of its effort goes to smooth video playback. Shown again the moment the intro starts closing. */
  :global(html.intro-open body > :not(.intro)) {
    visibility: hidden;
  }

  :global(html.intro-open body > :not(.intro) *) {
    animation-play-state: paused !important;
  }

  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #000;
    transition:
      opacity 0.9s var(--ease-out),
      visibility 0.9s;
  }

  .intro.is-leaving {
    opacity: 0;
    visibility: hidden;
  }

  /* The stage is always exactly 16:9 and fits inside the screen, so the whole frame (including the
     video's own captions at the bottom) is always visible; black bars fill any spare space. */
  .intro__stage {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(100vw, calc(100svh * 16 / 9));
    max-height: 100svh;
    aspect-ratio: 16 / 9;
  }

  .intro__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  /* Subtitles are drawn by .intro__subs; hide the browser's own rendering if it shows any. */
  .intro__video::cue {
    color: transparent;
    background: transparent;
  }

  .intro__subs {
    position: absolute;
    left: 50%;
    bottom: 17%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 86%;
    margin: 0;
    padding: 0.3em 0.75em;
    border-radius: 0.35em;
    background: rgba(8, 10, 13, 0.78);
    color: #fff;
    font-family: var(--font-body), "Nirmala UI", "Noto Sans Sinhala", "Noto Sans Tamil", "Noto Sans Devanagari",
      "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
    font-size: clamp(0.85rem, 2.1vw, 1.45rem);
    font-weight: 500;
    line-height: 1.45;
    text-align: center;
    white-space: pre-line;
    pointer-events: none;
  }

  .intro__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.25rem;
    background: linear-gradient(180deg, rgba(8, 10, 13, 0.55), transparent);
  }

  .intro__spacer {
    flex: 1;
  }

  .intro__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.4rem;
    padding: 0 1rem;
    border: 1px solid rgba(201, 164, 92, 0.45);
    border-radius: 999px;
    background: rgba(12, 14, 18, 0.55);
    backdrop-filter: blur(8px);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease-out),
      background 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }

  .intro__chip:hover,
  .intro__chip:focus-visible,
  .intro__chip:focus-within {
    border-color: var(--color-gold);
    outline: none;
  }

  .intro__chip--solid {
    border-color: var(--color-gold-fill);
    background: var(--color-gold-fill);
    color: var(--color-on-gold);
  }

  .intro__chip--solid:hover,
  .intro__chip--solid:focus-visible {
    background: var(--color-gold-bright);
    border-color: var(--color-gold-bright);
  }

  .intro__lang select {
    appearance: none;
    padding: 0 1rem 0 0;
    border: 0;
    background: transparent;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      right 0.35rem center,
      right 0.05rem center;
    background-size: 0.3rem 0.3rem;
    background-repeat: no-repeat;
    color: inherit;
    font-family: var(--font-body), "Nirmala UI", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    outline: none;
  }

  .intro__lang option {
    color: #0c0e12;
    background: #f4f1ec;
  }

  /* Muted (default): a gentle pulse invites people to turn the sound on. */
  .intro__sound[aria-pressed="false"] {
    animation: intro-pulse 2.4s ease-in-out 1.5s infinite;
  }

  .intro__sound[aria-pressed="false"] .intro__sound-waves,
  .intro__sound[aria-pressed="true"] .intro__sound-mute {
    display: none;
  }

  @keyframes intro-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(201, 164, 92, 0.45); }
    50% { box-shadow: 0 0 0 8px rgba(201, 164, 92, 0); }
  }

  .intro__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
  }

  .intro__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Phones: the controls wrap onto two rows above the video. */
  @media (max-width: 640px) {
    .intro__bar {
      gap: 0.5rem;
      padding: 0.75rem 1rem;
    }

    .intro__spacer {
      flex-basis: 100%;
      height: 0;
    }

    .intro__chip {
      min-height: 2.2rem;
      padding: 0 0.8rem;
      font-size: 0.6rem;
    }

    .intro__subs {
      bottom: 19%;
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__sound[aria-pressed="false"] {
      animation: none;
    }

    .intro {
      transition: none;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>("[data-intro]");
  const video = intro?.querySelector<HTMLVideoElement>("[data-intro-video]");

  if (intro && video) {
    const bar = intro.querySelector<HTMLElement>("[data-intro-progress]");
    const soundBtn = intro.querySelector<HTMLButtonElement>("[data-intro-sound]");
    const soundLabel = intro.querySelector<HTMLElement>("[data-intro-sound-label]");
    let closed = false;

    const close = () => {
      if (closed) return;
      closed = true;
      try {
        sessionStorage.setItem("mdc-intro-seen", "1");
      } catch {}
      intro.classList.add("is-leaving");
      document.documentElement.classList.remove("intro-open");
      video.pause();
      window.dispatchEvent(new Event("intro:closed"));
      setTimeout(() => {
        video.removeAttribute("src");
        video.load(); // stop any further downloading
        intro.remove();
      }, 1000);
    };

    intro.querySelectorAll("[data-intro-close]").forEach((btn) => btn.addEventListener("click", close));
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
    video.addEventListener("ended", close);

    video.addEventListener("timeupdate", () => {
      if (bar && video.duration) bar.style.transform = `scaleX(${video.currentTime / video.duration})`;
    });

    const syncSoundBtn = () => {
      soundBtn?.setAttribute("aria-pressed", String(!video.muted));
      if (soundLabel) soundLabel.textContent = video.muted ? "Sound on" : "Sound off";
    };

    const unmute = () => {
      video.muted = false;
      video.volume = 1;
      if (video.paused) video.play().catch(() => {});
      syncSoundBtn();
    };

    soundBtn?.addEventListener("click", () => {
      if (video.muted) unmute();
      else {
        video.muted = true;
        syncSoundBtn();
      }
    });

    // Sound on by default. Browsers block autoplay with sound until the visitor interacts with the
    // page, so: try with sound first; if refused, play muted and switch the sound on at the very
    // first click, tap or key press anywhere (the sound button handles its own click).
    const armUnmuteOnFirstInteraction = () => {
      const events = ["pointerdown", "keydown", "touchend"] as const;
      const onFirst = (event: Event) => {
        events.forEach((type) => document.removeEventListener(type, onFirst, true));
        if (closed || !video.muted) return;
        if (soundBtn && event.target instanceof Node && soundBtn.contains(event.target)) return;
        unmute();
      };
      events.forEach((type) => document.addEventListener(type, onFirst, true));
    };

    const startPlayback = () => {
      video.muted = false;
      video
        .play()
        .then(syncSoundBtn)
        .catch(() => {
          video.muted = true;
          syncSoundBtn();
          video.play().catch(() => {});
          armUnmuteOnFirstInteraction();
        });
    };

    // Subtitles: the chosen language's track is loaded (mode "hidden") and its current cue is drawn
    // in .intro__subs. Defaults to the visitor's browser language when we have it; remembers the choice.
    const langSelect = intro.querySelector<HTMLSelectElement>("[data-intro-lang]");
    const subs = intro.querySelector<HTMLElement>("[data-intro-subs]");
    const tracks = Array.from(video.textTracks);

    const renderCue = (track: TextTrack) => {
      if (!subs || track.mode !== "hidden") return;
      const cue = track.activeCues?.[0] as VTTCue | undefined;
      subs.textContent = cue?.text ?? "";
      subs.hidden = !cue;
    };

    const setLang = (code: string) => {
      tracks.forEach((t) => {
        t.mode = t.language === code ? "hidden" : "disabled";
      });
      if (subs) {
        subs.hidden = true;
        subs.lang = code;
        subs.dir = code === "ar" ? "rtl" : "ltr";
      }
      const active = tracks.find((t) => t.language === code);
      if (active) renderCue(active);
      try {
        localStorage.setItem("mdc-subs-lang", code);
      } catch {}
    };

    tracks.forEach((t) => t.addEventListener("cuechange", () => renderCue(t)));

    if (langSelect) {
      const available = new Set(tracks.map((t) => t.language));
      let initial = "";
      try {
        const saved = localStorage.getItem("mdc-subs-lang");
        if (saved !== null) initial = saved;
        else {
          const browser = (navigator.language || "").slice(0, 2).toLowerCase();
          if (available.has(browser)) initial = browser;
        }
      } catch {}
      if (!available.has(initial)) initial = "";
      langSelect.value = initial;
      setLang(initial);
      langSelect.addEventListener("change", () => setLang(langSelect.value));
    }

    startPlayback();
  }
</script>
