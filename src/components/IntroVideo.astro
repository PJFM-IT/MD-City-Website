---
import { INTRO_VIDEO_URL, SUBTITLE_LANGS, GIVING_URL } from "../data/site";
---

{
  INTRO_VIDEO_URL && (
    <section class="intro theme-dark" id="watch" data-intro aria-label="Miracle Dome City film">
      <div class="intro__stage" data-intro-stage>
        <!-- Two-sided card: the film on the front; when it ends the card turns over to the Giving
             invitation on the back, then turns back and the film plays again. -->
        <div class="intro__flip">
          <video
            class="intro__video"
            data-intro-video
            data-src={INTRO_VIDEO_URL}
            data-src-mobile={INTRO_VIDEO_URL.replace(/\.mp4$/, "-mobile.mp4")}
            poster="/videos/intro-poster.jpg"
            playsinline
            preload="auto"
          >
            {
              SUBTITLE_LANGS.map((l) => (
                <track kind="subtitles" srclang={l.code} label={l.name} src={`/subtitles/intro.${l.code}.vtt`} />
              ))
            }
            <!-- English: shown only when the screen shape trims off the film's own captions. -->
            <track kind="subtitles" srclang="en" label="English" src="/subtitles/intro.en.vtt" />
          </video>

          <div class="intro__back" data-intro-back aria-hidden="true">
            <div class="intro__back-inner">
              <span class="intro__ornament"></span>
              <h2 class="intro__back-title">Be a Part of the Miracle</h2>
              <a class="btn btn--solid intro__back-btn" href={GIVING_URL} target="_blank" rel="noopener" tabindex="-1">
                Giving
              </a>
            </div>
          </div>
        </div>

        <div class="intro__shade" aria-hidden="true"></div>
        <div class="intro__fade" aria-hidden="true"></div>

        <!-- Title over the film. -->
        <div class="intro__content">
          <span class="intro__ornament" aria-hidden="true"></span>
          <p class="intro__eyebrow">Where Heaven Meets Earth</p>
          <p class="intro__title">Miracle Dome City</p>
        </div>

        <!-- Translated subtitles sit just above the film's own (burned-in) English captions. -->
        <p class="intro__subs" data-intro-subs aria-live="polite" hidden></p>

        <!-- One control bar, bottom-right: sound on/off | subtitle language. -->
        <div class="intro__controls">
          <button class="intro__sound is-muted" type="button" data-intro-sound aria-label="Turn sound on" aria-pressed="false">
            <svg class="intro__sound-on" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
              <path d="M16 8.5a4.5 4.5 0 0 1 0 7M18.5 6a8 8 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
            <svg class="intro__sound-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
              <path d="M16.5 9.5l5 5M21.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
          </button>

          <span class="intro__divider" aria-hidden="true"></span>

          <label class="intro__lang">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M7 11h4M13 11h4M7 15h6M15 15h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <select data-intro-lang aria-label="Subtitle language">
              <option value="">Subtitles off</option>
              {SUBTITLE_LANGS.map((l) => <option value={l.code}>{l.name}</option>)}
            </select>
          </label>
        </div>

        <div class="intro__progress" aria-hidden="true">
          <span data-intro-progress></span>
        </div>
      </div>

      <a class="intro__scroll" href="#top" aria-label="Scroll to explore">
        <span>Scroll</span>
        <i aria-hidden="true"></i>
      </a>
    </section>
  )
}

<script is:inline>
  // Pick the file before the browser starts downloading: phones get the lighter 480p version.
  (function () {
    var v = document.querySelector("[data-intro-video]");
    if (!v) return;
    var small = window.matchMedia("(max-width: 900px)").matches;
    v.src = (small && v.dataset.srcMobile) || v.dataset.src;
  })();
</script>

<style>
  /* First section of the page. The film plays with sound and fills the screen below the header,
     with the Miracle Dome City title over it. */
  .intro {
    --gold-hi: #f1d488;
    position: relative;
    isolation: isolate;
    height: 100svh;
    min-height: 26rem;
    overflow: hidden;
    background: #050403;
  }

  .intro__stage {
    position: absolute;
    inset: var(--header-h) 0 0;
    perspective: 2200px;
  }

  /* ---------- The film / turning card ---------- */
  .intro__flip {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform 1.3s cubic-bezier(0.65, 0, 0.25, 1);
  }

  .intro.is-flipped .intro__flip {
    transform: rotateY(180deg);
  }

  .intro__video,
  .intro__back {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .intro__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }

  /* Subtitles are drawn by .intro__subs; hide the browser's own rendering if it shows any. */
  .intro__video::cue {
    color: transparent;
    background: transparent;
  }

  .intro__back {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    display: grid;
    place-items: center;
    transform: rotateY(180deg);
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(241, 212, 136, 0.22), transparent 70%),
      linear-gradient(180deg, rgba(8, 9, 12, 0.8), rgba(8, 9, 12, 0.95)),
      url("/videos/intro-poster.jpg") center / cover no-repeat,
      #0a0907;
    text-align: center;
  }

  .intro.is-flipped .intro__back {
    pointer-events: auto;
  }

  .intro__back-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.6rem, 2cqw, 1.4rem);
  }

  .intro__back-inner > * {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  }

  .intro.is-flipped .intro__back-inner > * {
    opacity: 1;
    transform: none;
  }

  .intro.is-flipped .intro__back-inner > :nth-child(1) { transition-delay: 0.9s; }
  .intro.is-flipped .intro__back-inner > :nth-child(2) { transition-delay: 1.05s; }
  .intro.is-flipped .intro__back-inner > :nth-child(3) { transition-delay: 1.25s; }

  .intro__back-inner > .intro__ornament {
    transform: translateY(14px) rotate(45deg);
  }

  .intro.is-flipped .intro__back-inner > .intro__ornament {
    transform: rotate(45deg);
  }

  .intro__back-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4.6cqw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.04em;
    background: linear-gradient(180deg, #fbe9b4 0%, var(--gold-hi) 45%, #b8914c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .intro__back-btn {
    min-width: clamp(8rem, 18cqw, 12rem);
    animation: intro-pulse 2.6s ease-in-out infinite;
  }

  /* ---------- Shade + title ---------- */
  /* Light touch: a soft darkening behind the title and at the bottom (controls, captions). */
  .intro__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 38% at 50% 44%, rgba(5, 4, 3, 0.55), transparent 75%),
      linear-gradient(180deg, rgba(5, 4, 3, 0.3) 0%, transparent 22%);
    transition: opacity 1.4s var(--ease-out);
  }

  /* A faint fade along the very bottom keeps the controls readable. */
  .intro__fade {
    position: absolute;
    inset: auto 0 0;
    height: 22%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(5, 4, 3, 0.45));
  }

  .intro__content {
    position: absolute;
    inset: 0 0 18%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.7rem, 2vh, 1.2rem);
    padding: 0 1.5rem;
    text-align: center;
    pointer-events: none;
    transition:
      opacity 1.4s var(--ease-out),
      transform 1.6s var(--ease-out);
  }

  /* Title opening: after the first few seconds the title fades away and the film plays clean.
     It comes back each time the film starts again. (Wide screens; on phones it sits above the
     film and stays.) */
  @media (min-aspect-ratio: 1/1) {
    .intro.is-settled .intro__shade,
    .intro.is-settled .intro__content {
      opacity: 0;
    }

    .intro.is-settled .intro__content {
      transform: scale(1.04);
    }
  }

  .intro.is-flipped .intro__shade,
  .intro.is-flipped .intro__content {
    opacity: 0;
  }

  .intro__content > * {
    animation: intro-rise 1.3s var(--ease-out) both;
  }

  .intro__content > :nth-child(2) { animation-delay: 0.15s; }
  .intro__content > :nth-child(3) { animation-delay: 0.3s; }

  @keyframes intro-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  .intro__ornament {
    display: block;
    width: 8px;
    height: 8px;
    border: 1px solid var(--gold-hi);
    box-shadow: 0 0 10px rgba(241, 212, 136, 0.6);
    transform: rotate(45deg);
  }

  .intro__content > .intro__ornament {
    animation-name: intro-rise-gem;
  }

  @keyframes intro-rise-gem {
    from { opacity: 0; transform: translateY(18px) rotate(45deg); }
    to { opacity: 1; transform: rotate(45deg); }
  }

  .intro__eyebrow {
    margin: 0;
    color: rgba(244, 241, 236, 0.92);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 2vw, 1.45rem);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.8);
  }

  .intro__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 6.4vw, 5.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: linear-gradient(180deg, #fff3cf 0%, var(--gold-hi) 45%, #b8914c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 16px rgba(0, 0, 0, 0.75));
  }

  /* ---------- Subtitles ---------- */
  .intro__subs {
    position: absolute;
    left: 50%;
    /* Just above the film's own captions (they sit in the bottom ~18% of the picture). */
    bottom: 17%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 86%;
    margin: 0;
    padding: 0.3em 0.8em;
    border-radius: 0.35em;
    background: rgba(8, 10, 13, 0.8);
    color: #fff;
    font-family: var(--font-body), "Nirmala UI", "Noto Sans Sinhala", "Noto Sans Tamil", "Noto Sans Devanagari",
      "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
    font-size: clamp(0.8rem, 2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.45;
    text-align: center;
    pointer-events: none;
  }

  /* When the film's own captions are trimmed off, ours take their place near the bottom. */
  .intro.captions-cut .intro__subs {
    bottom: 5.5rem;
    font-size: clamp(1rem, 1.9vw, 1.7rem);
  }

  .intro.is-flipped .intro__subs {
    visibility: hidden;
  }

  /* ---------- Controls ---------- */
  .intro__controls {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.3rem;
    border: 1px solid rgba(201, 164, 92, 0.45);
    border-radius: 999px;
    background: rgba(10, 11, 14, 0.55);
    backdrop-filter: blur(8px);
    opacity: 0.85;
    transition: opacity 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }

  .intro:hover .intro__controls,
  .intro__controls:focus-within {
    opacity: 1;
    border-color: rgba(241, 212, 136, 0.7);
  }

  .intro__sound {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fbe9b4;
    cursor: pointer;
    transition: background 0.25s var(--ease-out);
  }

  .intro__sound:hover,
  .intro__sound:focus-visible,
  .intro__lang:hover,
  .intro__lang:focus-within {
    background: rgba(241, 212, 136, 0.12);
    outline: none;
  }

  .intro__sound-off { display: none; }
  .intro__sound.is-muted .intro__sound-on { display: none; }
  .intro__sound.is-muted .intro__sound-off { display: block; }

  /* While muted, a soft gold pulse invites a tap. */
  .intro__sound.is-muted {
    animation: intro-pulse 2.6s ease-in-out 1s infinite;
  }

  @keyframes intro-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(241, 212, 136, 0.45); }
    50% { box-shadow: 0 0 0 8px rgba(241, 212, 136, 0); }
  }

  .intro__divider {
    width: 1px;
    height: 1.4rem;
    background: rgba(201, 164, 92, 0.4);
  }

  .intro__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 0.95rem 0 0.8rem;
    border-radius: 999px;
    color: var(--color-white);
    cursor: pointer;
    transition: background 0.25s var(--ease-out);
  }

  .intro__lang select {
    appearance: none;
    max-width: 11rem;
    padding: 0 1rem 0 0;
    border: 0;
    background: transparent;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      right 0.35rem center,
      right 0.05rem center;
    background-size: 0.3rem 0.3rem;
    background-repeat: no-repeat;
    color: inherit;
    font-family: var(--font-body), "Nirmala UI", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 0.76rem;
    cursor: pointer;
    outline: none;
  }

  .intro__lang option {
    color: #0c0e12;
    background: #f4f1ec;
  }

  .intro.is-flipped .intro__controls {
    opacity: 0;
    pointer-events: none;
  }

  /* Thin progress line along the bottom of the film. */
  .intro__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
  }

  .intro__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #b8914c, var(--gold-hi));
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ---------- Scroll cue ---------- */
  .intro__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    transform: translateX(-50%);
    color: rgba(244, 241, 236, 0.75);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
  }

  .intro__scroll i {
    position: relative;
    width: 1px;
    height: 2.2rem;
    overflow: hidden;
    background: rgba(241, 212, 136, 0.25);
  }

  .intro__scroll i::after {
    content: "";
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--gold-hi);
    animation: intro-scroll 2.2s ease-in-out infinite;
  }

  @keyframes intro-scroll {
    to { top: 100%; }
  }

  .intro__scroll:hover {
    color: var(--gold-hi);
  }

  /* Wide screens: the film's own captions run along the bottom, so the scroll cue stays off. */
  @media (min-aspect-ratio: 1/1) {
    .intro__scroll {
      display: none;
    }
  }

  /* ---------- Upright phones ---------- */
  /* Filling a tall screen would cut off most of the picture, so the whole 16:9 film sits in the
     middle: title above, controls below. */
  @media (max-aspect-ratio: 1/1) {
    .intro__stage {
      inset: auto 0;
      top: 50%;
      aspect-ratio: 16 / 9;
      transform: translateY(-50%);
      margin-top: calc(var(--header-h) / 2);
    }

    .intro__video {
      object-fit: contain;
    }

    .intro__shade,
    .intro__fade {
      display: none;
    }

    .intro__content {
      inset: auto 0 calc(100% + 1.75rem);
      gap: 0.55rem;
    }

    .intro__title {
      font-size: clamp(1.6rem, 8vw, 2.6rem);
    }

    .intro__eyebrow {
      font-size: 1rem;
    }

    .intro__subs {
      bottom: 19%;
      font-size: 0.75rem;
    }

    .intro__controls {
      top: calc(100% + 1rem);
      bottom: auto;
      right: auto;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__content > *,
    .intro__scroll i::after,
    .intro__sound.is-muted,
    .intro__back-btn {
      animation: none;
    }

    .intro__flip,
    .intro.is-flipped .intro__flip {
      transform: none;
    }

    .intro__back {
      transform: none;
      opacity: 0;
      transition: opacity 0.6s;
    }

    .intro.is-flipped .intro__back {
      opacity: 1;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>("[data-intro]");
  const video = intro?.querySelector<HTMLVideoElement>("[data-intro-video]");

  if (intro && video) {
    const bar = intro.querySelector<HTMLElement>("[data-intro-progress]");
    const soundBtn = intro.querySelector<HTMLButtonElement>("[data-intro-sound]");

    // ----- Progress line -----
    // ----- Progress line + title opening -----
    // The title shows for the first few seconds of the film, then fades away.
    const TITLE_SECONDS = 4.5;
    const syncTime = () => {
      if (bar && video.duration) bar.style.transform = `scaleX(${video.currentTime / video.duration})`;
      intro.classList.toggle("is-settled", video.currentTime > TITLE_SECONDS);
    };
    video.addEventListener("timeupdate", syncTime);
    video.addEventListener("seeked", syncTime);

    // ----- Full-screen fit -----
    // The film covers the whole area below the header, so wide screens trim some of its height.
    // Up to ~14% is taken from the top (heads stay in view, the film's own captions stay whole).
    // Beyond that, the bottom 14.5% (the burned-in captions) is trimmed instead and the same lines
    // are shown as clean English subtitles, with any remaining trim taken from the top.
    const CAPTION_BAND = 0.145;
    let captionsCut = false;
    let syncTrack: () => void = () => {};

    const fitFilm = () => {
      let cut = false;
      if (getComputedStyle(video).objectFit === "cover") {
        const ratio = video.videoWidth && video.videoHeight ? video.videoHeight / video.videoWidth : 9 / 16;
        const fh = video.clientWidth * ratio; // film height at full width
        const crop = fh - video.clientHeight;
        let y = 50;
        if (crop > 1) {
          if (crop <= CAPTION_BAND * fh) y = 100; // trim the top only
          else {
            cut = true;
            y = ((crop - CAPTION_BAND * fh) / crop) * 100;
          }
        }
        video.style.objectPosition = `50% ${y.toFixed(2)}%`;
      } else {
        video.style.objectPosition = "";
      }
      if (cut !== captionsCut) {
        captionsCut = cut;
        intro.classList.toggle("captions-cut", cut);
        syncTrack();
      }
    };

    fitFilm();
    window.addEventListener("resize", fitFilm);
    video.addEventListener("loadedmetadata", fitFilm);

    // ----- Sound + scrolling -----
    // The film plays with sound while it's on screen. Scrolling down mutes it; scrolling back up
    // brings the sound back. Fully off screen it pauses, and carries on when the visitor returns.
    //
    // Browsers block sound until the visitor has pressed something on the page. If that happens,
    // the film plays muted (the sound icon shows it), and the sound comes on with the first click,
    // tap or key press anywhere — or with the sound icon itself.
    let soundAllowed = false; // has the browser let us play with sound yet?
    let userMuted = false; // the visitor switched the sound off with the icon
    let mostlyInView = true; // at least half of the section on screen
    let onScreen = true; // any of it on screen
    let flipped = false; // showing the Giving side of the card

    const apply = () => {
      video.muted = !(soundAllowed && mostlyInView && !userMuted);
      if (!video.muted) video.volume = 1;
      const off = !(soundAllowed && !userMuted);
      soundBtn?.classList.toggle("is-muted", off);
      soundBtn?.setAttribute("aria-pressed", String(!off));
      soundBtn?.setAttribute("aria-label", off ? "Turn sound on" : "Turn sound off");
      if (flipped) return;
      if (onScreen && video.paused) video.play().catch(() => {});
      else if (!onScreen && !video.paused) video.pause();
    };

    const armSoundOnFirstInteraction = () => {
      const events = ["pointerdown", "keydown", "touchend"] as const;
      const onFirst = (e: Event) => {
        // A press on the sound icon is handled by the icon itself.
        if ((e.target as Element | null)?.closest?.("[data-intro-sound]")) return;
        events.forEach((type) => document.removeEventListener(type, onFirst, true));
        soundAllowed = true;
        apply();
      };
      events.forEach((type) => document.addEventListener(type, onFirst, true));
    };

    soundBtn?.addEventListener("click", () => {
      if (!soundAllowed || userMuted) {
        soundAllowed = true;
        userMuted = false;
      } else {
        userMuted = true;
      }
      apply();
    });

    // ----- End of the film: turn over to the Giving invitation, then back again -----
    const back = intro.querySelector<HTMLElement>("[data-intro-back]");
    const backBtn = back?.querySelector<HTMLAnchorElement>("a");
    const FLIP_MS = 1300; // matches the CSS turn
    const BACK_MS = 10000; // how long the Giving side stays
    let backTimer = 0;
    let backLeft = BACK_MS;
    let backStarted = 0;

    const flipToFilm = () => {
      window.clearTimeout(backTimer);
      intro.classList.remove("is-flipped");
      back?.setAttribute("aria-hidden", "true");
      backBtn?.setAttribute("tabindex", "-1");
      video.currentTime = 0;
      if (bar) bar.style.transform = "scaleX(0)";
      window.setTimeout(() => {
        flipped = false;
        apply();
      }, FLIP_MS * 0.5);
    };

    // The countdown only runs while the visitor can actually see the card.
    const runBackTimer = () => {
      window.clearTimeout(backTimer);
      backStarted = Date.now();
      backTimer = window.setTimeout(flipToFilm, backLeft);
    };

    video.addEventListener("ended", () => {
      flipped = true;
      backLeft = BACK_MS + FLIP_MS;
      intro.classList.add("is-flipped");
      back?.setAttribute("aria-hidden", "false");
      backBtn?.removeAttribute("tabindex");
      if (onScreen) runBackTimer();
    });

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          mostlyInView = entry.intersectionRatio >= 0.5;
          const wasOn = onScreen;
          onScreen = entry.isIntersecting;
          apply();
          if (flipped && wasOn !== onScreen) {
            if (onScreen) runBackTimer();
            else {
              window.clearTimeout(backTimer);
              backLeft = Math.max(1500, backLeft - (Date.now() - backStarted));
            }
          }
        },
        { threshold: [0, 0.5, 1] },
      ).observe(intro);
    }

    // ----- Subtitles -----
    // The chosen language's track is loaded (mode "hidden") and its current cue drawn in .intro__subs.
    // Defaults to the visitor's browser language when available; remembers the choice.
    const langSelect = intro.querySelector<HTMLSelectElement>("[data-intro-lang]");
    const subs = intro.querySelector<HTMLElement>("[data-intro-subs]");
    const tracks = Array.from(video.textTracks);
    let chosen = ""; // the visitor's subtitle language ("" = off)

    const renderCue = (track: TextTrack) => {
      if (!subs || track.mode !== "hidden") return;
      const cue = track.activeCues?.[0] as VTTCue | undefined;
      subs.textContent = cue?.text ?? "";
      subs.hidden = !cue;
    };

    const applyTrack = () => {
      const code = chosen || (captionsCut ? "en" : "");
      tracks.forEach((t) => {
        t.mode = t.language === code ? "hidden" : "disabled";
      });
      if (subs) {
        subs.hidden = true;
        subs.lang = code;
      }
      const active = tracks.find((t) => t.language === code);
      if (active) renderCue(active);
    };
    syncTrack = applyTrack;

    tracks.forEach((t) => t.addEventListener("cuechange", () => renderCue(t)));

    if (langSelect) {
      const available = new Set(tracks.map((t) => t.language).filter((c) => c !== "en"));
      let initial = "";
      try {
        const saved = localStorage.getItem("mdc-subs-lang");
        if (saved !== null) initial = saved;
        else {
          const browser = (navigator.language || "").slice(0, 2).toLowerCase();
          if (available.has(browser)) initial = browser;
        }
      } catch {}
      if (!available.has(initial)) initial = "";
      langSelect.value = initial;
      chosen = initial;
      langSelect.addEventListener("change", () => {
        chosen = langSelect.value;
        applyTrack();
        try {
          localStorage.setItem("mdc-subs-lang", chosen);
        } catch {}
      });
    }
    applyTrack();

    // ----- Start: with sound if the browser allows it, otherwise muted until the first press -----
    video.muted = false;
    video
      .play()
      .then(() => {
        soundAllowed = true;
        apply();
      })
      .catch(() => {
        soundAllowed = false;
        video.muted = true;
        video.play().catch(() => {});
        apply();
        armSoundOnFirstInteraction();
      });
  }
</script>
