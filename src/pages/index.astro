---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import TheVision from "../components/sections/TheVision.astro";
import ExploreCity from "../components/sections/ExploreCity.astro";
import Destinations from "../components/sections/Destinations.astro";
import CityNumbers from "../components/sections/CityNumbers.astro";
import HistoricGiving from "../components/sections/HistoricGiving.astro";
import HourProsperity from "../components/sections/HourProsperity.astro";
import TheVisionary from "../components/sections/TheVisionary.astro";
import FinalHero from "../components/sections/FinalHero.astro";
import Contact from "../components/sections/Contact.astro";
import Lightbox from "../components/Lightbox.astro";
---

<BaseLayout>
